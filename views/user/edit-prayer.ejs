<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Prayer</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
min-height:100vh;
padding:40px;
color:white;
font-family:Arial;
}

.form-box{
max-width:700px;
margin:auto;
background:rgba(255,255,255,0.1);
padding:35px;
border-radius:30px;
backdrop-filter:blur(10px);
}

.page-title{
font-size:45px;
font-weight:bold;
margin-bottom:25px;
text-align:center;
}

textarea,
select{
width:100%;
padding:15px;
border:none;
border-radius:15px;
margin-bottom:20px;
outline:none;
}

textarea{
height:180px;
resize:none;
}

button{
background:#ffcc00;
border:none;
padding:14px 22px;
border-radius:14px;
font-weight:bold;
}

button:hover{
background:white;
}

.back-btn{
display:inline-block;
margin-top:20px;
background:#00d4ff;
color:black;
padding:12px 18px;
border-radius:12px;
text-decoration:none;
font-weight:bold;
}

</style>

</head>
<body>

<div class="form-box">

<h1 class="page-title">
✏ Edit Prayer Request
</h1>

<form
action="/user/update-prayer/<%= prayer.id %>"
method="POST"
>

<select
name="category"
required
>

<option
value="Healing"
<%= prayer.category === 'Healing' ? 'selected' : '' %>
>
Healing
</option>

<option
value="Family"
<%= prayer.category === 'Family' ? 'selected' : '' %>
>
Family
</option>

<option
value="Studies"
<%= prayer.category === 'Studies' ? 'selected' : '' %>
>
Studies
</option>

<option
value="Financial"
<%= prayer.category === 'Financial' ? 'selected' : '' %>
>
Financial
</option>

<option
value="Thanksgiving"
<%= prayer.category === 'Thanksgiving' ? 'selected' : '' %>
>
Thanksgiving
</option>

<option
value="Guidance"
<%= prayer.category === 'Guidance' ? 'selected' : '' %>
>
Guidance
</option>

<option
value="Ministry"
<%= prayer.category === 'Ministry' ? 'selected' : '' %>
>
Ministry
</option>

<option
value="Personal"
<%= prayer.category === 'Personal' ? 'selected' : '' %>
>
Personal
</option>

</select>

<textarea
name="prayer"
required
><%= prayer.prayer %></textarea>

<button type="submit">
💾 Update Prayer
</button>

</form>

<a
href="/user/my-prayers"
class="back-btn"
>
← Back
</a>

</div>

</body>
</html>