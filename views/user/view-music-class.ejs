<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
View Music Class
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

}

/* TOP */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:30px;

flex-wrap:wrap;

gap:15px;

}

.page-title{

font-size:40px;
font-weight:700;

}

.back-btn{

background:#ffcc00;
color:black;

padding:12px 22px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* CARD */

.class-card{

background:
rgba(255,255,255,0.08);

padding:35px;

border-radius:30px;

backdrop-filter:blur(12px);

box-shadow:
0 8px 20px rgba(0,0,0,0.18);

border:
1px solid rgba(255,255,255,0.08);

}

/* TITLE */

.class-title{

font-size:42px;
font-weight:700;

margin-bottom:15px;

color:#ffcc00;

line-height:1.4;

}

/* CATEGORY */

.category-badge{

display:inline-block;

background:#00d4ff;
color:black;

padding:10px 18px;

border-radius:20px;

font-size:14px;

font-weight:700;

margin-bottom:25px;

}

/* GRID */

.info-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(250px,1fr));

gap:20px;

margin-bottom:25px;

}

/* INFO BOX */

.info-box{

background:
rgba(255,255,255,0.05);

padding:20px;

border-radius:18px;

}

.info-title{

font-size:14px;

color:#bbb;

margin-bottom:8px;

}

.info-value{

font-size:17px;

font-weight:600;

line-height:1.8;

}

/* DESCRIPTION */

.description-box{

background:
rgba(255,255,255,0.05);

padding:24px;

border-radius:20px;

line-height:1.9;

margin-top:20px;

font-size:16px;

}

/* BUTTONS */

.button-group{

margin-top:30px;

display:flex;

gap:15px;

flex-wrap:wrap;

}

.join-btn{

background:#00d4ff;
color:black;

padding:14px 24px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

.join-btn:hover{

background:white;

transform:translateY(-2px);

}

/* RESPONSIVE */

@media(max-width:768px){

body{
padding:18px;
}

.class-title{
font-size:32px;
}

.page-title{
font-size:30px;
}

}

</style>

</head>

<body>

<!-- TOP -->

<div class="top-bar">

<h1 class="page-title">
🎵 Music Class Details
</h1>

<a
href="/user/music-classes"
class="back-btn"
>
← Back
</a>

</div>

<!-- CARD -->

<div class="class-card">

<!-- TITLE -->

<div class="class-title">

<%= musicClass.class_name %>

</div>

<!-- CATEGORY -->

<div class="category-badge">

<%= musicClass.category %>

</div>

<!-- INFO GRID -->

<div class="info-grid">

<!-- TRAINER -->

<div class="info-box">

<div class="info-title">
👨‍🏫 Trainer
</div>

<div class="info-value">

<%= musicClass.trainer %>

</div>

</div>

<!-- SCHEDULE -->

<div class="info-box">

<div class="info-title">
📅 Schedule
</div>

<div class="info-value">

<%= musicClass.schedule %>

</div>

</div>

<!-- LOCATION -->

<div class="info-box">

<div class="info-title">
📍 Location
</div>

<div class="info-value">

<%= musicClass.location %>

</div>

</div>

</div>

<!-- DESCRIPTION -->

<div class="description-box">

<%= musicClass.description %>

</div>

<!-- BUTTONS -->

<div class="button-group">

<a
href="/user/join-music-class/<%= musicClass.id %>"
class="join-btn"
>
🎵 Join This Class
</a>

</div>

</div>

</body>
</html>