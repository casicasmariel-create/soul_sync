<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Church Announcements</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
padding:28px;
}

/* ===================================== */
/* TOP BAR */
/* ===================================== */

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:28px;
flex-wrap:wrap;
gap:15px;
}

/* ===================================== */
/* PAGE TITLE */
/* ===================================== */

.page-title{
font-size:34px;
font-weight:700;
}

/* ===================================== */
/* BUTTON */
/* ===================================== */

.back-btn{

background:#ffcc00;
color:black;

padding:10px 16px;

border-radius:12px;

text-decoration:none;

font-weight:600;

font-size:14px;

transition:0.3s;
}

.back-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

/* ===================================== */
/* GRID */
/* ===================================== */

.announcement-wrapper{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:20px;
}

/* ===================================== */
/* CARD */
/* ===================================== */

.announcement-card{

width:100%;

background:
rgba(255,255,255,0.10);

padding:22px;

border-radius:22px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;

display:flex;
flex-direction:column;
}

.announcement-card:hover{
transform:translateY(-3px);
}

/* ===================================== */
/* TITLE */
/* ===================================== */

.announcement-title{

font-size:22px;

font-weight:700;

color:#ffcc00;

margin-bottom:12px;

line-height:1.3;

white-space:nowrap;

overflow:hidden;

text-overflow:ellipsis;
}

/* ===================================== */
/* CONTENT */
/* ===================================== */

.announcement-content{

white-space:pre-line;

font-size:14px;

line-height:1.6;

color:#f1f1f1;

margin-bottom:14px;

opacity:0.92;
}

/* ===================================== */
/* DATE */
/* ===================================== */

.announcement-date{
font-size:13px;
opacity:0.75;
margin-top:auto;
}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:992px){

body{
padding:18px;
}

.page-title{
font-size:28px;
}

.announcement-wrapper{
grid-template-columns:1fr;
}

.announcement-title{
font-size:20px;
}

}

</style>

</head>
<body>

<!-- ===================================== -->
<!-- TOP BAR -->
<!-- ===================================== -->

<div class="top-bar">

<h1 class="page-title">
📢 Church Announcements
</h1>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

<!-- ===================================== -->
<!-- ANNOUNCEMENTS -->
<!-- ===================================== -->

<div class="announcement-wrapper">

<% announcements.forEach(announcement => { %>

<div class="announcement-card">

<!-- TITLE -->

<h2 class="announcement-title">
<%= announcement.title %>
</h2>

<!-- CONTENT -->

<div class="announcement-content">
<%= announcement.content %>
</div>

<!-- DATE -->

<div class="announcement-date">

🕒

<%= new Date(
new Date(announcement.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

</div>

<% }) %>

</div>

</body>
</html>