<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Church Announcements</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:40px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.back-btn:hover{
background:white;
transform:scale(1.03);
}

.page-title{
font-size:55px;
font-weight:bold;
}

.announcement-wrapper{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(350px, 420px));

justify-content:center;

gap:30px;

}

.announcement-card{

width:100%;
height:auto;

background:rgba(255,255,255,0.1);

padding:30px;

border-radius:30px;

backdrop-filter:blur(10px);

box-shadow:0 8px 25px rgba(0,0,0,0.15);

transition:0.3s;

display:flex;
flex-direction:column;
justify-content:flex-start;
}

.announcement-card:hover{
transform:translateY(-4px);
}

.announcement-title{

font-size:32px;
font-weight:bold;
color:#ffcc00;

margin-bottom:14px;

line-height:1.2;
}

.announcement-content{

white-space:pre-line;

font-size:18px;

line-height:1.6;

color:#f1f1f1;

margin-bottom:15px;
}

.announcement-date{
font-size:14px;
opacity:0.7;
margin-top:auto;
}

@media(max-width:768px){

.page-title{
font-size:38px;
}

body{
padding:20px;
}

.announcement-wrapper{
grid-template-columns:1fr;
}

.announcement-title{
font-size:28px;
}

.announcement-content{
font-size:16px;
}

}

</style>

</head>
<body>

<div class="top-bar">

<h1 class="page-title">
📢 Church Announcements
</h1>

<a href="/dashboard" class="back-btn">
← Back Dashboard
</a>

</div>

<div class="announcement-wrapper">

<% announcements.forEach(announcement => { %>

<div class="announcement-card">

<h2 class="announcement-title">
<%= announcement.title %>
</h2>

<div class="announcement-content">
<%= announcement.content %>
</div>

<div class="announcement-date">

🕒

<%= new Date(
new Date(announcement.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

</div>

<% }) %>

</div>

</body>
</html>