<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Music Classes
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI', sans-serif;
}

body{

background:
linear-gradient(
135deg,
#14001f,
#2a0038,
#43005c
);

min-height:100vh;

padding:22px;

color:white;

}

/* MAIN */

.main-container{

max-width:1180px;

margin:auto;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:10px;

margin-bottom:20px;

}

/* TITLE */

.page-title{

font-size:28px;

font-weight:700;

display:flex;

align-items:center;

gap:10px;

}

/* DASHBOARD BUTTON */

.back-btn{

background:#ffcc00;

color:black;

padding:10px 16px;

border-radius:10px;

text-decoration:none;

font-size:13px;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* HEADER */

.header-box{

background:
rgba(255,255,255,0.07);

padding:24px;

border-radius:22px;

margin-bottom:24px;

backdrop-filter:blur(10px);

border:
1px solid rgba(255,255,255,0.05);

}

/* HEADER TITLE */

.header-title{

font-size:24px;

font-weight:700;

margin-bottom:8px;

color:#ffcc00;

}

/* HEADER TEXT */

.header-text{

font-size:14px;

line-height:1.8;

opacity:0.9;

max-width:850px;

}

/* GRID */

.class-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(340px,1fr));

gap:18px;

}

/* CARD */

.class-card{

background:
rgba(255,255,255,0.07);

padding:22px;

border-radius:22px;

backdrop-filter:blur(10px);

border:
1px solid rgba(255,255,255,0.05);

transition:0.3s;

display:flex;

flex-direction:column;

}

.class-card:hover{

transform:translateY(-3px);

background:
rgba(255,255,255,0.09);

}

/* HEADER */

.class-header{

display:flex;

justify-content:space-between;

align-items:flex-start;

margin-bottom:18px;

}

/* TITLE */

.class-title{

font-size:22px;

font-weight:700;

margin-bottom:12px;

color:#ffcc00;

}

/* CATEGORY */

.category-badge{

display:inline-block;

background:#11cfff;

color:black;

padding:7px 14px;

border-radius:20px;

font-size:11px;

font-weight:700;

}

/* DETAILS */

.details-grid{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:14px;

margin-bottom:18px;

}

/* DETAIL ITEM */

.detail-item{

background:
rgba(255,255,255,0.04);

padding:14px;

border-radius:14px;

}

/* LABEL */

.detail-label{

font-size:11px;

color:#bbbbbb;

margin-bottom:5px;

}

/* VALUE */

.detail-value{

font-size:14px;

font-weight:600;

line-height:1.5;

}

/* DESCRIPTION */

.class-description{

font-size:13px;

line-height:1.9;

opacity:0.92;

margin-bottom:20px;

padding:15px;

background:
rgba(255,255,255,0.04);

border-radius:14px;

}

/* FOOTER */

.class-footer{

display:flex;

justify-content:space-between;

align-items:center;

gap:15px;

flex-wrap:wrap;

margin-top:auto;

}

/* STATUS */

.joined-status{

color:#00ff99;

font-size:13px;

font-weight:700;

}

.not-joined-status{

color:#ffcc00;

font-size:13px;

font-weight:700;

}

/* BUTTON GROUP */

.button-group{

display:flex;

gap:10px;

flex-wrap:wrap;

}

/* BUTTONS */

.present-btn,
.join-btn,
.leave-btn{

padding:10px 16px;

border:none;

border-radius:12px;

font-size:13px;

font-weight:700;

text-decoration:none;

cursor:pointer;

transition:0.3s;

}

/* PRESENT */

.present-btn{

background:#00d4ff;

color:black;

}

/* JOIN */

.join-btn{

background:#00d4ff;

color:black;

}

/* LEAVE */

.leave-btn{

background:#ff4d6d;

color:white;

}

/* HOVER */

.present-btn:hover,
.join-btn:hover,
.leave-btn:hover{

background:white;

color:black;

transform:translateY(-2px);

}

/* EMPTY */

.empty-box{

background:
rgba(255,255,255,0.07);

padding:50px 20px;

border-radius:24px;

text-align:center;

}

/* RESPONSIVE */

@media(max-width:768px){

.page-title{

font-size:24px;

}

.header-title{

font-size:20px;

}

.class-title{

font-size:20px;

}

.details-grid{

grid-template-columns:1fr;

}

.class-footer{

flex-direction:column;

align-items:flex-start;

}

body{

padding:16px;

}

}

</style>

</head>

<body>

<div class="main-container">

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
🎵 Music Classes
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- HEADER -->

<div class="header-box">

<div class="header-title">
🎶 Worship & Ministry Training
</div>

<div class="header-text">

Grow your musical gifts and serve the ministry through worship training, instrument classes, and spiritual development.

</div>

</div>

<!-- CLASS GRID -->

<div class="class-grid">

<% if(classes.length > 0){ %>

<% classes.forEach(item => { %>

<div class="class-card">

<!-- HEADER -->

<div class="class-header">

<div>

<h2 class="class-title">

<%= item.class_name %>

</h2>

<div class="category-badge">

<%= item.category %>

</div>

</div>

</div>

<!-- DETAILS -->

<div class="details-grid">

<div class="detail-item">

<div class="detail-label">
👨‍🏫 Trainer
</div>

<div class="detail-value">

<%= item.trainer %>

</div>

</div>

<div class="detail-item">

<div class="detail-label">
📅 Schedule
</div>

<div class="detail-value">

<%= item.schedule %>

</div>

</div>

<div class="detail-item">

<div class="detail-label">
📍 Location
</div>

<div class="detail-value">

<%= item.location %>

</div>

</div>

</div>

<!-- DESCRIPTION -->

<div class="class-description">

<%= item.description %>

</div>

<!-- FOOTER -->

<div class="class-footer">

<!-- STATUS -->

<div>

<% if(item.joined > 0){ %>

<span class="joined-status">

✅ Joined

</span>

<% } else { %>

<span class="not-joined-status">

⏳ Not Joined

</span>

<% } %>

</div>

<!-- BUTTONS -->

<div class="button-group">

<% if(item.joined > 0){ %>

<!-- PRESENT -->

<form
action="/user/record-attendance/<%= item.id %>"
method="POST"
>

<button
type="submit"
class="present-btn"
>

✅ Present

</button>

</form>

<!-- LEAVE -->

<a
href="/user/leave-music-class/<%= item.id %>"
class="leave-btn"
>

🚪 Leave

</a>

<% } else { %>

<!-- JOIN -->

<a
href="/user/join-music-class/<%= item.id %>"
class="join-btn"
>

🎵 Join Class

</a>

<% } %>

</div>

</div>

</div>

<% }) %>

<% } else { %>

<div class="empty-box">

<h3>
🎵 No Music Classes Yet
</h3>

<p>
Please wait for ministry training announcements.
</p>

</div>

<% } %>

</div>

</div>

</body>
</html>