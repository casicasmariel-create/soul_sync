<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
My Music Attendance
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:20px;

color:white;

}

/* CONTAINER */

.main-container{

max-width:1100px;

margin:auto;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:12px;

margin-bottom:20px;

}

/* TITLE */

.page-title{

font-size:30px;

font-weight:700;

}

/* BUTTON */

.back-btn{

background:#ffcc00;

color:black;

padding:10px 16px;

border-radius:12px;

text-decoration:none;

font-weight:700;

font-size:14px;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* TABLE BOX */

.table-box{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:24px;

backdrop-filter:blur(10px);

box-shadow:
0 5px 14px rgba(0,0,0,0.15);

}

/* TABLE */

table{

width:100%;

border-collapse:collapse;

}

/* HEADER */

th{

padding:14px;

background:
rgba(255,255,255,0.08);

color:#ffcc00;

font-size:14px;

text-align:left;

}

/* DATA */

td{

padding:14px;

font-size:14px;

border-bottom:
1px solid rgba(255,255,255,0.08);

}

/* STATUS */

.present{

color:#00ff99;
font-weight:700;

}

.late{

color:#ffcc00;
font-weight:700;

}

.absent{

color:#ff4d6d;
font-weight:700;

}

/* EMPTY */

.empty-box{

text-align:center;

padding:50px 20px;

opacity:0.8;

}

/* RESPONSIVE */

@media(max-width:768px){

.page-title{

font-size:24px;

}

body{

padding:15px;

}

}

</style>

</head>

<body>

<div class="main-container">

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
📋 My Music Attendance
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- TABLE -->

<div class="table-box">

<% if(attendance.length > 0){ %>

<table>

<thead>

<tr>

<th>
#
</th>

<th>
🎵 Music Class
</th>

<th>
📅 Attendance Date
</th>

<th>
📌 Status
</th>

</tr>

</thead>

<tbody>

<% attendance.forEach((item, index) => { %>

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<%= item.class_name %>
</td>

<td>

<%= new Date(
item.attendance