<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youth Member Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
overflow-x:hidden;
}

/* ===================================== */
/* SIDEBAR */
/* ===================================== */

.sidebar{

width:300px;

height:100vh;

position:fixed;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

padding:24px 18px;

overflow-y:auto;

border-right:
1px solid rgba(255,255,255,0.1);
}

.logo{
width:80px;
display:block;
margin:auto;
margin-bottom:10px;
}

.brand{
text-align:center;
font-size:26px;
font-weight:700;
margin-bottom:28px;
}

.role{
text-align:center;
background:#00d4ff;
color:black;
padding:10px;
border-radius:12px;
font-weight:600;
font-size:14px;
margin-bottom:26px;
}

/* ===================================== */
/* MENU */
/* ===================================== */

.menu a{

display:flex;
align-items:center;
gap:10px;

padding:12px 14px;

margin-bottom:12px;

border-radius:14px;

text-decoration:none;

color:white;

background:
rgba(255,255,255,0.08);

transition:0.3s;

font-size:13px;

font-weight:600;

white-space:nowrap;

overflow:hidden;

text-overflow:ellipsis;
}

.menu a:hover{
background:#ffcc00;
color:black;
transform:translateX(4px);
}

/* ===================================== */
/* MAIN */
/* ===================================== */

.main{
margin-left:320px;
padding:28px;
}

/* ===================================== */
/* TOP CARD */
/* ===================================== */

.top-card{

background:
rgba(255,255,255,0.10);

backdrop-filter:blur(12px);

padding:28px;

border-radius:24px;

margin-bottom:24px;

box-shadow:
0 6px 20px rgba(0,0,0,0.15);
}

.top-card h1{
font-size:32px;
font-weight:700;
margin-bottom:10px;
}

.top-card h4{
font-size:18px;
margin-bottom:10px;
}

.top-card p{
font-size:14px;
opacity:0.85;
line-height:1.6;
}

/* ===================================== */
/* MEMBER BADGE */
/* ===================================== */

.member-badge{
background:#00d4ff;
color:black;
display:inline-block;
padding:8px 14px;
border-radius:10px;
font-weight:600;
font-size:13px;
margin-top:14px;
}

/* ===================================== */
/* GRID */
/* ===================================== */

.grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
margin-bottom:24px;
}

/* ===================================== */
/* CARDS */
/* ===================================== */

.card-box{

background:
rgba(255,255,255,0.10);

padding:22px;

border-radius:20px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;
}

.card-box:hover{
transform:translateY(-3px);
}

.card-box h5{
font-size:15px;
margin-bottom:12px;
font-weight:600;
}

/* ===================================== */
/* VALUES */
/* ===================================== */

.value{
font-size:32px;
font-weight:700;
color:#00d4ff;
}

/* ===================================== */
/* SECTION */
/* ===================================== */

.section{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:22px;

margin-bottom:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);
}

.section h3{
margin-bottom:18px;
font-size:22px;
font-weight:700;
}

/* ===================================== */
/* ACTIVITY */
/* ===================================== */

.activity{

background:
rgba(255,255,255,0.08);

padding:14px 16px;

border-radius:14px;

margin-bottom:12px;

font-size:14px;

display:flex;
align-items:center;
gap:10px;

transition:0.3s;
}

.activity:hover{
background:rgba(255,255,255,0.14);
}

/* ===================================== */
/* QUICK ACTIONS */
/* ===================================== */

.quick-actions{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.quick-card{

background:
rgba(255,255,255,0.08);

padding:22px;

border-radius:18px;

text-decoration:none;

color:white;

transition:0.3s;
}

.quick-card:hover{
background:#ffcc00;
color:black;
transform:translateY(-3px);
}

.quick-card h4{
font-size:18px;
margin-bottom:10px;
}

.quick-card p{
font-size:13px;
line-height:1.6;
opacity:0.85;
}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:992px){

.sidebar{
position:relative;
width:100%;
height:auto;
border-right:none;
}

.main{
margin-left:0;
padding:18px;
}

.grid{
grid-template-columns:1fr;
}

.quick-actions{
grid-template-columns:1fr;
}

.top-card h1{
font-size:26px;
}

}

</style>

</head>
<body>

<!-- ===================================== -->
<!-- SIDEBAR -->
<!-- ===================================== -->

<div class="sidebar">

<img src="/images/church-logo.png" class="logo">

<div class="brand">
SoulSync
</div>

<div class="role">
Youth Member
</div>

<div class="menu">

<a href="/dashboard">
🏠 Dashboard
</a>

<a href="/user/announcements">
📢 Church Announcements
</a>

<a href="/user/events">
📅 Join Events
</a>

<a href="/user/prayer-requests">
🙏 Prayer Requests
</a>

<a href="/user/music-classes">
🎵 Music Classes
</a>

<a href="#">
📖 Bible Streak
</a>

<a href="#">
🎤 Worship Songs
</a>

<a href="#">
👤 My Profile
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<!-- ===================================== -->
<!-- MAIN -->
<!-- ===================================== -->

<div class="main">

<div class="top-card">

<h1>
Youth Member Dashboard
</h1>

<h4>
Welcome, <%= user.fullname %>
</h4>

<p>
Participate, connect, and grow spiritually with the youth ministry community through prayer support, church events, music ministry, and fellowship activities.
</p>

<div class="member-badge">
MEMBER ACCESS
</div>

</div>

<!-- ANALYTICS -->

<div class="grid">

<div class="card-box">

<h5>
📖 Bible Reading Streak
</h5>

<div class="value">
15
</div>

</div>

<div class="card-box">

<h5>
📅 Upcoming Events
</h5>

<div class="value">
6
</div>

</div>

<div class="card-box">

<h5>
🙏 Prayer Supports
</h5>

<div class="value">
20
</div>

</div>

<div class="card-box">

<h5>
🎵 Music Sessions
</h5>

<div class="value">
4
</div>

</div>

</div>

<!-- QUICK ACTIONS -->

<div class="section">

<h3>
⚡ Quick Actions
</h3>

<div class="quick-actions">

<a
href="/user/prayer-requests"
class="quick-card"
>

<h4>
🙏 Prayer Requests
</h4>

<p>
Submit prayers, support community prayers, and manage your testimonies.
</p>

</a>

<a
href="/user/events"
class="quick-card"
>

<h4>
📅 Join Events
</h4>

<p>
View upcoming church and youth fellowship activities.
</p>

</a>

<a
href="/user/announcements"
class="quick-card"
>

<h4>
📢 Announcements
</h4>

<p>
Stay updated with ministry announcements and schedules.
</p>

</a>

</div>

</div>

<!-- ACTIVITIES -->

<div class="section">

<h3>
📌 Member Activities
</h3>

<div class="activity">
📢 View church announcements
</div>

<div class="activity">
📅 Join youth fellowship events
</div>

<div class="activity">
🙏 Submit and support prayer requests
</div>

<div class="activity">
🎵 Attend music training schedules
</div>

<div class="activity">
📖 Track Bible reading streak
</div>

<div class="activity">
🎤 View assigned worship songs
</div>

</div>

</div>

</body>
</html>