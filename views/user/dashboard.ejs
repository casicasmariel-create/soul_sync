<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Youth Member Dashboard
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
overflow-x:hidden;

}

/* ===================================== */
/* SIDEBAR */
/* ===================================== */

.sidebar{

width:300px;
height:100vh;

position:fixed;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

padding:24px 18px;

overflow-y:auto;

border-right:
1px solid rgba(255,255,255,0.1);

}

.logo{

width:80px;
display:block;
margin:auto;
margin-bottom:10px;

}

.brand{

text-align:center;
font-size:30px;
font-weight:700;
margin-bottom:28px;

}

.role{

text-align:center;

background:#00d4ff;

color:black;

padding:10px;

border-radius:12px;

font-weight:700;

font-size:14px;

margin-bottom:26px;

}

/* ===================================== */
/* MENU */
/* ===================================== */

.menu a{

display:flex;
align-items:center;
gap:10px;

padding:13px 15px;

margin-bottom:12px;

border-radius:14px;

text-decoration:none;

color:white;

background:
rgba(255,255,255,0.08);

transition:0.3s;

font-size:14px;

font-weight:600;

}

.menu a:hover{

background:#ffcc00;
color:black;
transform:translateX(4px);

}

/* ===================================== */
/* MAIN */
/* ===================================== */

.main{

margin-left:320px;
padding:28px;

}

/* ===================================== */
/* TOP CARD */
/* ===================================== */

.top-card{

background:
rgba(255,255,255,0.10);

backdrop-filter:blur(12px);

padding:28px;

border-radius:24px;

margin-bottom:24px;

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

}

.top-card h1{

font-size:34px;
font-weight:700;
margin-bottom:10px;

}

.top-card h4{

font-size:18px;
margin-bottom:10px;

}

.top-card p{

font-size:14px;
opacity:0.85;
line-height:1.7;

}

/* ===================================== */
/* MEMBER BADGE */
/* ===================================== */

.member-badge{

background:#00d4ff;

color:black;

display:inline-block;

padding:8px 14px;

border-radius:10px;

font-weight:700;

font-size:13px;

margin-top:14px;

}

/* ===================================== */
/* GRID */
/* ===================================== */

.grid{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:18px;

margin-bottom:24px;

}

/* ===================================== */
/* CARD BOX */
/* ===================================== */

.card-box{

background:
rgba(255,255,255,0.10);

padding:26px;

border-radius:20px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;

min-height:150px;

}

.card-box:hover{

transform:translateY(-3px);

box-shadow:
0 0 20px rgba(0,212,255,0.15);

}

.card-box h5{

font-size:16px;

margin-bottom:18px;

font-weight:700;

}

/* ===================================== */
/* VALUES */
/* ===================================== */

.value{

font-size:40px;

font-weight:700;

color:#00d4ff;

}

/* ===================================== */
/* SECTION */
/* ===================================== */

.section{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:22px;

margin-bottom:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

}

.section h3{

margin-bottom:18px;

font-size:22px;

font-weight:700;

}

/* ===================================== */
/* QUICK ACTIONS */
/* ===================================== */

.quick-actions{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:18px;

}

.quick-card{

background:
rgba(255,255,255,0.08);

padding:22px;

border-radius:18px;

text-decoration:none;

color:white;

transition:0.3s;

}

.quick-card:hover{

background:#ffcc00;

color:black;

transform:translateY(-3px);

}

.quick-card h4{

font-size:18px;

margin-bottom:10px;

}

.quick-card p{

font-size:13px;

line-height:1.6;

opacity:0.85;

}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:992px){

.sidebar{

position:relative;
width:100%;
height:auto;
border-right:none;

}

.main{

margin-left:0;
padding:18px;

}

.grid{

grid-template-columns:1fr;

}

.quick-actions{

grid-template-columns:1fr;

}

.top-card h1{

font-size:26px;

}

}

</style>

</head>

<body>

<!-- ===================================== -->
<!-- SIDEBAR -->
<!-- ===================================== -->

<div class="sidebar">

<img
src="/church-logo.png"
class="logo"
>

<div class="brand">
SoulSync
</div>

<div class="role">
Youth Member
</div>

<div class="menu">

<a href="/user/dashboard">
🏠 Dashboard
</a>

<a href="/user/announcements">
📢 Church Announcements
</a>

<a href="/user/events">
📅 Join Events
</a>

<a href="/user/prayer-requests">
🙏 Prayer Request
</a>

<a href="/user/music-classes">
🎵 Music Classes
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<!-- ===================================== -->
<!-- MAIN -->
<!-- ===================================== -->

<div class="main">

<!-- ===================================== -->
<!-- TOP CARD -->
<!-- ===================================== -->

<div class="top-card">

<h1>
Youth Member Dashboard
</h1>

<h4>
Welcome, <%= user.fullname %>
</h4>

<p>
Participate, connect, and grow spiritually with the youth ministry community through prayer support, church events, music ministry, and fellowship activities.
</p>

<div class="member-badge">
MEMBER ACCESS
</div>

</div>

<!-- ===================================== -->
<!-- MEMBER OVERVIEW -->
<!-- ===================================== -->

<div class="grid">

<div class="card-box">

<h5>
🎵 Joined Music Classes
</h5>

<div class="value">
<%= joinedClasses || 0 %>
</div>

</div>

<div class="card-box">

<h5>
📅 Events Joined
</h5>

<div class="value">
<%= joinedEvents || 0 %>
</div>

</div>

<div class="card-box">

<h5>
🙏 Prayer Requests
</h5>

<div class="value">
<%= prayerCount || 0 %>
</div>

</div>

</div>

</div>

</div>

</body>

</html>