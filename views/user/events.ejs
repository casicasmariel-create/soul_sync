<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youth Events</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
padding:28px;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:28px;
flex-wrap:wrap;
gap:15px;
}

.page-title{
font-size:34px;
font-weight:700;
}

.back-btn{
background:#ffcc00;
color:black;
padding:10px 16px;
border-radius:12px;
text-decoration:none;
font-weight:600;
font-size:14px;
transition:0.3s;
}

.back-btn:hover{
background:white;
transform:translateY(-2px);
}

.table-box{

background:
rgba(255,255,255,0.08);

padding:24px;

border-radius:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

overflow-x:auto;
}

.table{
margin-bottom:0;
border-radius:14px;
overflow:hidden;
}

.table th{
background:#2c003e !important;
color:#ffcc00 !important;
padding:14px;
text-align:center;
font-size:15px;
}

.table td{
padding:14px;
vertical-align:middle;
font-size:14px;
}

.event-title{
font-size:20px;
font-weight:700;
color:#ffcc00;
margin-bottom:8px;
}

.event-description{
white-space:pre-line;
line-height:1.8;
opacity:0.92;
font-size:14px;
}

.event-date{
font-size:13px;
opacity:0.8;
margin-top:10px;
}

.join-btn,
.not-btn{

padding:9px 14px;

border-radius:10px;

text-decoration:none;

font-weight:600;

font-size:13px;

display:inline-block;

margin-bottom:8px;

transition:0.3s;
}

.join-btn{
background:#00d4ff;
color:black;
}

.join-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

.not-btn{
background:#ff3b3b;
color:white;
}

.not-btn:hover{
background:#ff6666;
color:white;
transform:translateY(-2px);
}

.status-box{
padding:9px 14px;
border-radius:10px;
font-weight:600;
font-size:13px;
display:inline-block;
}

.joining{
background:#00d4ff;
color:black;
}

.notjoining{
background:#ff3b3b;
color:white;
}

.action-column{
min-width:220px;
text-align:center;
}

@media(max-width:992px){

body{
padding:18px;
}

.page-title{
font-size:28px;
}

.table th,
.table td{
font-size:13px;
padding:12px;
}

.event-title{
font-size:18px;
}

}

</style>

</head>
<body>

<div class="top-bar">

<h1 class="page-title">
📅 Youth Events
</h1>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

<div class="table-box">

<table class="table table-dark table-bordered align-middle">

<thead>

<tr>

<th style="width:50px;">
#
</th>

<th>
Event Details
</th>

<th style="width:240px;">
Participation
</th>

</tr>

</thead>

<tbody>

<% if(events && events.length > 0){ %>

<% events.forEach((event, index) => { %>

<tr>

<td class="text-center">
<%= index + 1 %>
</td>

<td>

<div class="event-title">
<%= event.title %>
</div>

<div class="event-description">
<%= event.description %>
</div>

<div class="event-date">
📅 <%= event.event_date %>
</div>

</td>

<td class="action-column">

<%

let userResponse = null;

if(
typeof responses !== 'undefined' &&
typeof user !== 'undefined'
){

responses.forEach(response => {

if(
response.event_id == event.id &&
response.user_id == user.id
){
userResponse = response.response_status;
}

});

}

%>

<% if(userResponse === 'JOINING'){ %>

<div class="status-box joining mb-3">
✅ JOINING
</div>

<br>

<a
href="/user/not-join-event/<%= event.id %>"
class="not-btn"
>
❌ Cancel
</a>

<% } else if(userResponse === 'NOT JOINING'){ %>

<div class="status-box notjoining mb-3">
❌ NOT JOINING
</div>

<br>

<a
href="/user/join-event/<%= event.id %>"
class="join-btn"
>
🔄 Change Mind
</a>

<% } else { %>

<a
href="/user/join-event/<%= event.id %>"
class="join-btn"
>
✅ Join Event
</a>

<br>

<a
href="/user/not-join-event/<%= event.id %>"
class="not-btn"
>
❌ Not Joining
</a>

<% } %>

</td>

</tr>

<% }) %>

<% } else { %>

<tr>

<td colspan="3" class="text-center">

No events available.

</td>

</tr>

<% } %>

</tbody>

</table>

</div>

</body>
</html>