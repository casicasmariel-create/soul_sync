<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Prayer Requests</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
padding:40px;
min-height:100vh;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:35px;
flex-wrap:wrap;
gap:15px;
}

.page-title{
font-size:50px;
font-weight:bold;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 22px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.back-btn:hover{
background:white;
transform:scale(1.03);
}

.form-box{
background:rgba(255,255,255,0.1);
padding:35px;
border-radius:30px;
backdrop-filter:blur(10px);
margin-bottom:35px;
box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

textarea{
width:100%;
height:180px;
border:none;
border-radius:20px;
padding:20px;
resize:none;
margin-bottom:20px;
outline:none;
}

select{
width:100%;
border:none;
border-radius:16px;
padding:15px;
margin-bottom:20px;
outline:none;
}

button{
background:#ffcc00;
border:none;
padding:14px 22px;
border-radius:15px;
font-weight:bold;
transition:0.3s;
}

button:hover{
background:white;
transform:scale(1.03);
}

.prayer-wrapper{
display:grid;
grid-template-columns:
repeat(auto-fit, minmax(350px, 420px));
justify-content:center;
gap:25px;
}

.prayer-card{
background:rgba(255,255,255,0.1);
padding:28px;
border-radius:28px;
backdrop-filter:blur(10px);
box-shadow:0 8px 25px rgba(0,0,0,0.15);
display:flex;
flex-direction:column;
}

.prayer-name{
font-size:28px;
font-weight:bold;
color:#ffcc00;
margin-bottom:12px;
}

.category{
display:inline-block;
background:#00d4ff;
color:black;
padding:8px 14px;
border-radius:12px;
font-weight:bold;
font-size:14px;
margin-bottom:15px;
width:fit-content;
}

.status{
display:inline-block;
padding:8px 14px;
border-radius:12px;
font-weight:bold;
font-size:14px;
margin-bottom:18px;
width:fit-content;
}

.pending{
background:#ffc107;
color:black;
}

.praying{
background:#0dcaf0;
color:black;
}

.answered{
background:#198754;
color:white;
}

.prayer-content{
white-space:pre-line;
line-height:1.7;
font-size:17px;
margin-bottom:18px;
}

.pray-btn{
border-radius:12px;
font-weight:bold;
padding:10px 16px;
}

.prayed-count{
font-size:14px;
margin-bottom:15px;
opacity:0.85;
}

.date{
font-size:14px;
opacity:0.75;
margin-top:auto;
}

@media(max-width:768px){

body{
padding:20px;
}

.page-title{
font-size:38px;
}

.prayer-wrapper{
grid-template-columns:1fr;
}

}

</style>

</head>
<body>

<div class="top-bar">

<h1 class="page-title">
🙏 Prayer Requests
</h1>

<a href="/dashboard" class="back-btn">
← Back Dashboard
</a>

</div>

<div class="form-box">

<form action="/user/create-prayer-request" method="POST">

<select
name="category"
required
>

<option value="">
Select Prayer Category
</option>

<option value="Healing">
Healing
</option>

<option value="Family">
Family
</option>

<option value="Studies">
Studies
</option>

<option value="Financial">
Financial
</option>

<option value="Thanksgiving">
Thanksgiving
</option>

<option value="Guidance">
Guidance
</option>

<option value="Ministry">
Ministry
</option>

<option value="Personal">
Personal
</option>

</select>

<textarea
name="prayer"
placeholder="Type your prayer request here..."
required
></textarea>

<div style="margin-bottom:20px;">

<input
type="checkbox"
name="anonymous"
value="YES"
>

<label>
Submit as Anonymous
</label>

</div>

<button type="submit">
🙏 Submit Prayer Request
</button>

</form>

</div>

<div class="prayer-wrapper">

<% prayers.forEach(prayer => { %>

<div class="prayer-card">

<div class="prayer-name">

<% if(prayer.anonymous === 'YES'){ %>

🙏 Anonymous User

<% } else { %>

<%= prayer.fullname %>

<% } %>

</div>

<div class="category">
<%= prayer.category %>
</div>

<div class="status
<%= prayer.status === 'Pending Prayer'
? 'pending'
: prayer.status === 'Currently Praying'
? 'praying'
: 'answered'
%>
">

<%= prayer.status %>

</div>

<div class="prayer-content">
<%= prayer.prayer %>
</div>

<div style="margin-bottom:18px;">

<a
href="/user/pray-for/<%= prayer.id %>"
class="btn btn-info btn-sm pray-btn"
>
🙏 Pray For This
</a>

</div>

<div class="prayed-count">

🙏
<%= prayer.prayed_count || 0 %>

People Prayed For This

</div>

<div class="date">

🕒

<%= new Date(
new Date(prayer.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

</div>

<% }) %>

</div>

</body>
</html>