<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
My Music Classes
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

margin-bottom:30px;

}

.page-title{

font-size:40px;
font-weight:700;

}

.back-btn{

background:#ffcc00;
color:black;

padding:12px 20px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* HEADER */

.header-box{

background:
rgba(255,255,255,0.08);

padding:28px;

border-radius:28px;

margin-bottom:30px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

}

.header-title{

font-size:32px;
font-weight:700;

margin-bottom:10px;

color:#ffcc00;

}

.header-sub{

line-height:1.8;

opacity:0.9;

}

/* CLASS GRID */

.class-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(340px,1fr));

gap:25px;

}

/* CARD */

.class-card{

background:
rgba(255,255,255,0.08);

padding:25px;

border-radius:28px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

display:flex;

flex-direction:column;

transition:0.3s;

border:
1px solid rgba(255,255,255,0.08);

}

.class-card:hover{

transform:translateY(-4px);

background:
rgba(255,255,255,0.10);

}

/* TITLE */

.class-title{

font-size:28px;
font-weight:700;

margin-bottom:14px;

color:#ffcc00;

line-height:1.4;

}

/* CATEGORY */

.category-badge{

display:inline-block;

background:#00d4ff;
color:black;

padding:8px 14px;

border-radius:20px;

font-size:13px;

font-weight:700;

margin-bottom:18px;

width:fit-content;

}

/* INFO BOX */

.info-box{

background:
rgba(255,255,255,0.05);

padding:14px;

border-radius:16px;

margin-bottom:14px;

}

.info-title{

font-size:13px;

color:#bbb;

margin-bottom:5px;

}

.info-value{

font-size:15px;

font-weight:600;

line-height:1.6;

}

/* DESCRIPTION */

.description-box{

background:
rgba(255,255,255,0.04);

padding:16px;

border-radius:16px;

line-height:1.8;

margin-top:10px;

margin-bottom:20px;

color:#f1f1f1;

flex:1;

}

/* BUTTONS */

.button-group{

display:flex;

gap:12px;

flex-wrap:wrap;

margin-top:auto;

}

.leave-btn,
.view-btn{

padding:12px 18px;

border-radius:14px;

text-decoration:none;

font-weight:700;

font-size:14px;

transition:0.3s;

display:inline-flex;

align-items:center;

justify-content:center;

gap:8px;

}

/* VIEW */

.view-btn{

background:#ffcc00;
color:black;

}

/* LEAVE */

.leave-btn{

background:#ff4d6d;
color:white;

}

/* HOVER */

.view-btn:hover,
.leave-btn:hover{

background:white;
color:black;

transform:translateY(-2px);

}

/* EMPTY */

.empty-box{

text-align:center;

padding:70px 20px;

opacity:0.8;

}

/* RESPONSIVE */

@media(max-width:768px){

body{
padding:18px;
}

.page-title{
font-size:32px;
}

.header-title{
font-size:26px;
}

.class-title{
font-size:24px;
}

}

</style>

</head>

<body>

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
🎵 My Music Classes
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- HEADER -->

<div class="header-box">

<div class="header-title">
🎶 Your Ministry Journey
</div>

<div class="header-sub">

Manage your joined worship training classes, track schedules, and continue growing your musical gifts for ministry service.

</div>

</div>

<!-- GRID -->

<div class="class-grid">

<% if(classes.length > 0){ %>

<% classes.forEach(item => { %>

<div class="class-card">

<!-- TITLE -->

<div class="class-title">

<%= item.class_name %>

</div>

<!-- CATEGORY -->

<div class="category-badge">

<%= item.category %>

</div>

<!-- TRAINER -->

<div class="info-box">

<div class="info-title">
👨‍🏫 Trainer
</div>

<div class="info-value">

<%= item.trainer %>

</div>

</div>

<!-- SCHEDULE -->

<div class="info-box">

<div class="info-title">
📅 Schedule
</div>

<div class="info-value">

<%= item.schedule %>

</div>

</div>

<!-- LOCATION -->

<div class="info-box">

<div class="info-title">
📍 Location
</div>

<div class="info-value">

<%= item.location %>

</div>

</div>

<!-- JOINED DATE -->

<div class="info-box">

<div class="info-title">
✅ Joined At
</div>

<div class="info-value">

<%= new Date(item.joined_at).toLocaleDateString() %>

</div>

</div>

<!-- DESCRIPTION -->

<div class="description-box">

<%= item.description %>

</div>

<!-- BUTTONS -->

<div class="button-group">

<a
href="/user/view-music-class/<%= item.id %>"
class="view-btn"
>
👀 View Details
</a>

<a
href="/user/leave-music-class/<%= item.id %>"
class="leave-btn"
>
🚪 Leave Class
</a>

</div>

</div>

<% }) %>

<% } else { %>

<div class="empty-box">

<h2>
🎵 No Joined Classes Yet
</h2>

<p style="margin-top:10px;">
Start joining ministry training classes to grow your musical gifts.
</p>

</div>

<% } %>

</div>

</body>
</html>