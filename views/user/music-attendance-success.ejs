<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Attendance Success
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

height:100vh;

display:flex;

justify-content:center;

align-items:center;

padding:20px;

color:white;

}

/* BOX */

.success-box{

background:
rgba(255,255,255,0.08);

padding:50px;

border-radius:32px;

text-align:center;

backdrop-filter:blur(12px);

box-shadow:
0 8px 20px rgba(0,0,0,0.18);

max-width:550px;

width:100%;

}

/* ICON */

.success-icon{

font-size:90px;

margin-bottom:20px;

}

/* TITLE */

.success-title{

font-size:40px;

font-weight:700;

margin-bottom:15px;

color:#00ff99;

}

/* MESSAGE */

.success-message{

line-height:1.9;

opacity:0.9;

font-size:16px;

margin-bottom:30px;

}

/* BUTTONS */

.button-group{

display:flex;

justify-content:center;

gap:15px;

flex-wrap:wrap;

}

/* BUTTON */

.dashboard-btn,
.attendance-btn{

padding:14px 22px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

/* DASHBOARD */

.dashboard-btn{

background:#ffcc00;
color:black;

}

/* ATTENDANCE */

.attendance-btn{

background:#00d4ff;
color:black;

}

/* HOVER */

.dashboard-btn:hover,
.attendance-btn:hover{

background:white;

transform:translateY(-2px);

}

/* RESPONSIVE */

@media(max-width:768px){

.success-box{
padding:35px;
}

.success-title{
font-size:30px;
}

.success-icon{
font-size:70px;
}

}

</style>

</head>

<body>

<div class="success-box">

<!-- ICON -->

<div class="success-icon">
✅
</div>

<!-- TITLE -->

<div class="success-title">
Attendance Recorded
</div>

<!-- MESSAGE -->

<div class="success-message">

Your worship training attendance has been successfully recorded. Thank you for participating in the ministry music class.

</div>

<!-- BUTTONS -->

<div class="button-group">

<a
href="/dashboard"
class="dashboard-btn"
>
🏠 Dashboard
</a>

<a
href="/user/my-music-attendance"
class="attendance-btn"
>
📋 View Attendance
</a>

</div>

</div>

</body>
</html>