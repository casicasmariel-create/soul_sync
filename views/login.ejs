<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoulSync Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background: linear-gradient(135deg, #12001f, #2c003e, #4b006e);
            overflow:hidden;
        }

        .background-circle{
            position:absolute;
            width:500px;
            height:500px;
            background:rgba(255,255,255,0.05);
            border-radius:50%;
            top:-150px;
            left:-150px;
        }

        .background-circle2{
            position:absolute;
            width:400px;
            height:400px;
            background:rgba(255,255,255,0.05);
            border-radius:50%;
            bottom:-120px;
            right:-120px;
        }

        .login-container{
            width:400px;
            padding:40px;
            border-radius:25px;
            background:rgba(255,255,255,0.1);
            backdrop-filter: blur(12px);
            box-shadow:0 8px 32px rgba(0,0,0,0.3);
            text-align:center;
            color:white;
            z-index:10;
        }

        .logo{
            width:120px;
            height:120px;
            object-fit:contain;
            margin-bottom:15px;
        }

        .title{
            font-size:32px;
            font-weight:bold;
            margin-bottom:5px;
        }

        .subtitle{
            font-size:14px;
            color:#ddd;
            margin-bottom:30px;
        }

        .form-control{
            height:50px;
            border-radius:15px;
            border:none;
            margin-bottom:20px;
            background:rgba(255,255,255,0.15);
            color:white;
        }

        .form-control::placeholder{
            color:#ddd;
        }

        .form-control:focus{
            box-shadow:none;
            background:rgba(255,255,255,0.2);
            color:white;
        }

        .login-btn{
            width:100%;
            height:50px;
            border:none;
            border-radius:15px;
            background:#ffcc00;
            color:black;
            font-weight:bold;
            transition:0.3s;
        }

        .login-btn:hover{
            background:white;
            transform:scale(1.02);
        }

        .register-link{
            margin-top:20px;
            display:block;
            color:#fff;
            text-decoration:none;
        }

        .register-link:hover{
            color:#ffcc00;
        }

    </style>
</head>
<body>

    <div class="background-circle"></div>
    <div class="background-circle2"></div>

    <div class="login-container">

        <img src="church-logo.png" class="logo" alt="Church Logo">

        <div class="title">SoulSync</div>

        <div class="subtitle">
            Youth Ministry Engagement Platform
        </div>

        <form action="/login" method="POST">

            <input
                type="email"
                name="email"
                class="form-control"
                placeholder="Enter Email"
                required
            >

            <input
                type="password"
                name="password"
                class="form-control"
                placeholder="Enter Password"
                required
            >

            <button type="submit" class="login-btn">
                Login
            </button>

        </form>

        <a href="/register" class="register-link">
            Create Account
        </a>

    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>