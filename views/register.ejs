<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoulSync Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background: linear-gradient(135deg, #12001f, #2c003e, #4b006e);
            overflow:hidden;
        }

        .background-circle{
            position:absolute;
            width:500px;
            height:500px;
            background:rgba(255,255,255,0.05);
            border-radius:50%;
            top:-150px;
            left:-150px;
        }

        .background-circle2{
            position:absolute;
            width:400px;
            height:400px;
            background:rgba(255,255,255,0.05);
            border-radius:50%;
            bottom:-120px;
            right:-120px;
        }

        .register-container{
            width:430px;
            padding:40px;
            border-radius:25px;
            background:rgba(255,255,255,0.1);
            backdrop-filter: blur(12px);
            box-shadow:0 8px 32px rgba(0,0,0,0.3);
            text-align:center;
            color:white;
            z-index:10;
        }

        .logo{
            width:110px;
            height:110px;
            object-fit:contain;
            margin-bottom:10px;
        }

        .title{
            font-size:32px;
            font-weight:bold;
            margin-bottom:5px;
        }

        .subtitle{
            font-size:14px;
            color:#ddd;
            margin-bottom:25px;
        }

        .form-control{
            height:50px;
            border-radius:15px;
            border:none;
            margin-bottom:18px;
            background:rgba(255,255,255,0.15);
            color:white;
            padding-left:15px;
        }

        .form-control::placeholder{
            color:#ddd;
        }

        .form-control:focus{
            box-shadow:none;
            background:rgba(255,255,255,0.2);
            color:white;
        }

        .select-wrapper{
            position:relative;
            margin-bottom:18px;
        }

        .custom-select{
            width:100%;
            height:50px;
            border:none;
            border-radius:15px;
            padding:0 15px;
            background:rgba(255,255,255,0.15);
            color:white;
            outline:none;
            appearance:none;
            -webkit-appearance:none;
            -moz-appearance:none;
            backdrop-filter: blur(10px);
            cursor:pointer;
            transition:0.3s;
        }

        .custom-select:focus{
            background:rgba(255,255,255,0.2);
        }

        .custom-select option{
            background:#3d1457;
            color:white;
            border:none;
            padding:10px;
        }

        .select-wrapper::after{
            content:'▼';
            position:absolute;
            right:18px;
            top:50%;
            transform:translateY(-50%);
            color:#ffcc00;
            pointer-events:none;
            font-size:12px;
        }

        .register-btn{
            width:100%;
            height:50px;
            border:none;
            border-radius:15px;
            background:#ffcc00;
            color:black;
            font-weight:bold;
            transition:0.3s;
            margin-top:10px;
        }

        .register-btn:hover{
            background:white;
            transform:scale(1.02);
        }

        .login-link{
            margin-top:20px;
            display:block;
            color:white;
            text-decoration:none;
        }

        .login-link:hover{
            color:#ffcc00;
        }

    </style>
</head>
<body>

    <div class="background-circle"></div>
    <div class="background-circle2"></div>

    <div class="register-container">

        <img src="/images/church-logo.png" class="logo" alt="Church Logo">

        <div class="title">SoulSync</div>

        <div class="subtitle">
            Create Your Account
        </div>

        <form action="/register" method="POST">

            <input
                type="text"
                name="fullname"
                class="form-control"
                placeholder="Full Name"
                required
            >

            <input
                type="email"
                name="email"
                class="form-control"
                placeholder="Enter Email"
                required
            >

            <input
                type="password"
                name="password"
                class="form-control"
                placeholder="Enter Password"
                required
            >

            <div class="select-wrapper">

                <select name="role" class="custom-select" required>

                    <option value="">Select Account Type</option>

                    <option value="admin">
                        Admin
                    </option>

                    <option value="user">
                        User
                    </option>

                </select>

            </div>

            <button type="submit" class="register-btn">
                Create Account
            </button>

        </form>

        <a href="/login" class="login-link">
            Already have an account?
        </a>

    </div>

</body>
</html>