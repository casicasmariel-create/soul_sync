<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Music Attendance Analytics
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:20px;

color:white;

}

/* MAIN CONTAINER */

.main-container{

max-width:1250px;

margin:auto;

}

/* HEADER */

.top-header{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:12px;

margin-bottom:20px;

}

/* TITLE */

.page-title{

font-size:28px;

font-weight:700;

display:flex;

align-items:center;

gap:10px;

}

/* BUTTON */

.back-btn{

background:#ffcc00;

color:black;

padding:8px 14px;

border-radius:10px;

text-decoration:none;

font-weight:700;

font-size:13px;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* ANALYTICS GRID */

.analytics-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(180px,1fr));

gap:12px;

margin-bottom:20px;

}

/* CARD */

.analytics-card{

padding:12px;

border-radius:16px;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

box-shadow:
0 4px 10px rgba(0,0,0,0.15);

min-height:85px;

transition:0.3s;

}

.analytics-card:hover{

transform:translateY(-2px);

}

/* LABEL */

.analytics-card h4{

font-size:14px;

margin-bottom:4px;

font-weight:600;

}

/* VALUE */

.analytics-card h1{

font-size:26px;

font-weight:700;

margin:0;

line-height:1;

}

/* COLORS */

.present{

background:#198754;

}

.late{

background:#ffc107;

color:black;

}

.absent{

background:#dc3545;

}

.rate{

background:#00cfff;

color:black;

}

/* TABLE BOX */

.table-box{

background:
rgba(255,255,255,0.08);

padding:18px;

border-radius:20px;

backdrop-filter:blur(10px);

box-shadow:
0 4px 10px rgba(0,0,0,0.15);

overflow-x:auto;

}

/* TABLE TITLE */

.table-title{

font-size:22px;

font-weight:700;

margin-bottom:15px;

display:flex;

align-items:center;

gap:8px;

}

/* TABLE */

table{

width:100%;

border-collapse:collapse;

}

/* HEADER */

th{

padding:12px;

background:
rgba(255,255,255,0.08);

color:#ffcc00;

font-size:14px;

text-align:left;

}

/* DATA */

td{

padding:12px;

font-size:14px;

border-bottom:
1px solid rgba(255,255,255,0.08);

}

/* HOVER */

tr:hover{

background:
rgba(255,255,255,0.04);

}

/* STATUS */

.status-badge{

padding:7px 14px;

border-radius:20px;

font-size:12px;

font-weight:700;

display:inline-block;

}

.present-badge{

background:#198754;

}

.late-badge{

background:#ffc107;

color:black;

}

.absent-badge{

background:#dc3545;

}

/* SESSION HEADER */

.session-header{

background:#2f1140;

color:#ffcc00;

font-weight:700;

padding:16px;

font-size:15px;

}

/* RESPONSIVE */

@media(max-width:768px){

.page-title{

font-size:22px;

}

.analytics-grid{

grid-template-columns:
repeat(2,1fr);

}

.analytics-card{

min-height:75px;

}

.analytics-card h1{

font-size:22px;

}

.table-title{

font-size:18px;

}

body{

padding:15px;

}

}

</style>

</head>

<body>

<div class="main-container">

<!-- HEADER -->

<div class="top-header">

<h1 class="page-title">
📊 Attendance Analytics
</h1>

<a
href="/admin/music-classes"
class="back-btn"
>
← Back To Music Classes
</a>

</div>

<!-- ANALYTICS -->

<div class="analytics-grid">

<div class="analytics-card present">

<h4>
✅ Total Present
</h4>

<h1>
<%= totalPresent %>
</h1>

</div>

<div class="analytics-card late">

<h4>
⏰ Total Late
</h4>

<h1>
<%= totalLate %>
</h1>

</div>

<div class="analytics-card absent">

<h4>
❌ Total Absent
</h4>

<h1>
<%= totalAbsent %>
</h1>

</div>

<div class="analytics-card rate">

<h4>
📈 Attendance Rate
</h4>

<h1>
<%= attendanceRate %>%
</h1>

</div>

</div>

<!-- TABLE -->

<div class="table-box">

<h2 class="table-title">
🔥 Attendance History
</h2>

<table>

<thead>

<tr>

<th>
#
</th>

<th>
👤 Trainee Name
</th>

<th>
📅 Attendance Date
</th>

<th>
🕒 Check-In Time
</th>

<th>
📌 Status
</th>

</tr>

</thead>

<tbody>

<% let currentSession = null; %>

<% sessionHistory.forEach((item, index) => { %>

<!-- SESSION HEADER -->

<% if(currentSession !== item.session_id){ %>

<tr>

<td
colspan="5"
style="
background:#2f1140;
color:#ffcc00;
font-weight:700;
padding:16px;
font-size:15px;
border-top:3px solid #ffcc00;
"
>

📅 Attendance Session

—
<%= item.session_date %>

</td>

</tr>

<% currentSession = item.session_id; %>

<% } %>

<!-- ATTENDANCE RECORD -->

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<%= item.fullname || 'No User' %>
</td>

<td>
<%= item.session_date %>
</td>

<td>

<% if(item.check_in_time){ %>

<%= new Date(item.check_in_time)
.toLocaleTimeString() %>

<% } else { %>

No Check-In

<% } %>

</td>

<td>

<% if(item.status === 'Present'){ %>

<span class="status-badge present-badge">
✅ Present
</span>

<% } else if(item.status === 'Late'){ %>

<span class="status-badge late-badge">
⏰ Late
</span>

<% } else { %>

<span class="status-badge absent-badge">
❌ Absent
</span>

<% } %>

</td>

</tr>

<% }) %>

</tbody>
</html>