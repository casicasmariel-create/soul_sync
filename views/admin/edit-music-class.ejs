<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Edit Music Class
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

display:flex;
justify-content:center;
align-items:center;

}

/* FORM BOX */

.form-box{

width:100%;
max-width:750px;

background:
rgba(255,255,255,0.08);

padding:35px;

border-radius:30px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 25px rgba(0,0,0,0.15);

}

/* TITLE */

.page-title{

font-size:38px;

font-weight:700;

margin-bottom:25px;

color:#ffcc00;

text-align:center;

}

/* LABEL */

.form-label{

font-weight:600;

margin-bottom:8px;

}

/* INPUT */

.form-control,
.form-select{

padding:14px;

border:none;

border-radius:14px;

margin-bottom:20px;

}

textarea{

resize:none;
height:160px;

}

/* BUTTONS */

.button-group{

display:flex;

gap:15px;

flex-wrap:wrap;

margin-top:10px;

}

.update-btn{

flex:1;

background:#00d4ff;
color:black;

border:none;

padding:14px;

border-radius:14px;

font-size:16px;

font-weight:700;

transition:0.3s;

}

.back-btn{

flex:1;

background:#ffcc00;
color:black;

text-decoration:none;

padding:14px;

border-radius:14px;

font-size:16px;

font-weight:700;

text-align:center;

transition:0.3s;

}

.update-btn:hover,
.back-btn:hover{

background:white;

transform:translateY(-2px);

}

@media(max-width:768px){

body{
padding:18px;
}

.page-title{
font-size:30px;
}

}

</style>

</head>

<body>

<div class="form-box">

<h1 class="page-title">
✏ Edit Music Class
</h1>

<form
action="/admin/update-music-class/<%= musicClass.id %>"
method="POST"
>

<!-- CLASS NAME -->

<label class="form-label">
Class Name
</label>

<input
type="text"
name="class_name"
class="form-control"
value="<%= musicClass.class_name %>"
required
>

<!-- TRAINER -->

<label class="form-label">
Trainer
</label>

<input
type="text"
name="trainer"
class="form-control"
value="<%= musicClass.trainer %>"
required
>

<!-- CATEGORY -->

<label class="form-label">
Category
</label>

<input
type="text"
name="category"
class="form-control"
value="<%= musicClass.category %>"
required
>

<!-- SCHEDULE -->

<label class="form-label">
Schedule
</label>

<input
type="text"
name="schedule"
class="form-control"
value="<%= musicClass.schedule %>"
required
>

<!-- LOCATION -->

<label class="form-label">
Location
</label>

<input
type="text"
name="location"
class="form-control"
value="<%= musicClass.location %>"
required
>

<!-- DESCRIPTION -->

<label class="form-label">
Description
</label>

<textarea
name="description"
class="form-control"
required
><%= musicClass.description %></textarea>

<!-- BUTTONS -->

<div class="button-group">

<button
type="submit"
class="update-btn"
>
💾 Update Music Class
</button>

<a
href="/admin/music-classes"
class="back-btn"
>
← Back
</a>

</div>

</form>

</div>

</body>
</html>