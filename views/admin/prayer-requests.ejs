<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Prayer Requests</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
padding:40px;
min-height:100vh;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
}

.back-btn:hover{
background:white;
}

.prayer-card{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
margin-bottom:20px;
backdrop-filter:blur(10px);
box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

.prayer-card h3{
color:#ffcc00;
margin-bottom:10px;
}

.date{
color:#ddd;
font-size:14px;
margin-top:10px;
}

</style>

</head>
<body>

<div class="top-bar">

<h1>🙏 Prayer Requests</h1>

<a href="/dashboard" class="back-btn">
Back Dashboard
</a>

</div>

<% prayers.forEach(prayer => { %>

<div class="prayer-card">

<h3>
<%= prayer.fullname %>
</h3>

<p>
<%= prayer.prayer %>
</p>

<div class="date">
Prayer Support Request
</div>

</div>

<% }) %>

</body>
</html>