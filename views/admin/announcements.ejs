<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create Announcement</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
font-family:Arial;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
}

.main-box{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
backdrop-filter:blur(10px);
}

input{
width:100%;
height:55px;
border:none;
border-radius:15px;
padding:15px;
margin-bottom:18px;
}

textarea{
width:100%;
height:180px;
border:none;
border-radius:15px;
padding:15px;
resize:none;
margin-bottom:18px;
line-height:1.5;
}

.button-group{
display:flex;
gap:12px;
flex-wrap:wrap;
}

.post-btn{
background:#ffcc00;
color:black;
border:none;
padding:12px 22px;
border-radius:14px;
font-weight:bold;
}

.view-btn{
background:#00d4ff;
color:black;
text-decoration:none;
padding:12px 22px;
border-radius:14px;
font-weight:bold;
display:flex;
align-items:center;
}

</style>

</head>
<body>

<div class="top-bar">

<h1>📢 Create Announcement</h1>

<a href="/dashboard" class="back-btn">
← Back Dashboard
</a>

</div>

<div class="main-box">

<form action="/admin/create-announcement" method="POST">

<input
type="text"
name="title"
placeholder="Announcement Title"
required
>

<textarea
name="content"
placeholder="Write your church announcement here..."
required
></textarea>

<div class="button-group">

<button type="submit" class="post-btn">
📢 Post Announcement
</button>

<a href="/admin/announcements-list" class="view-btn">
📋 View Announcements
</a>

</div>

</form>

</div>

</body>
</html>