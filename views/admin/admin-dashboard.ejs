<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youth President Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
overflow-x:hidden;
}

.sidebar{
width:280px;
height:100vh;
position:fixed;
background:rgba(255,255,255,0.08);
backdrop-filter:blur(12px);
padding:30px 20px;
overflow-y:auto;
border-right:1px solid rgba(255,255,255,0.1);
}

.logo{
width:95px;
display:block;
margin:auto;
margin-bottom:12px;
}

.brand{
text-align:center;
font-size:30px;
font-weight:bold;
margin-bottom:35px;
}

.role{
text-align:center;
background:#ffcc00;
color:black;
padding:10px;
border-radius:15px;
font-weight:bold;
margin-bottom:30px;
}

.menu a{
display:block;
padding:15px;
margin-bottom:14px;
border-radius:18px;
text-decoration:none;
color:white;
background:rgba(255,255,255,0.08);
transition:0.3s;
font-size:15px;
}

.menu a:hover{
background:#ffcc00;
color:black;
transform:translateX(5px);
}

.main{
margin-left:300px;
padding:40px;
}

.top-card{
background:rgba(255,255,255,0.1);
backdrop-filter:blur(12px);
padding:35px;
border-radius:30px;
margin-bottom:30px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
gap:20px;
margin-bottom:30px;
}

.card{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
}

.value{
font-size:40px;
font-weight:bold;
color:#ffcc00;
}

.section{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
margin-bottom:25px;
}

.section h3{
margin-bottom:20px;
}

.activity{
background:rgba(255,255,255,0.08);
padding:18px;
border-radius:18px;
margin-bottom:15px;
}

.admin-badge{
background:#ffcc00;
color:black;
display:inline-block;
padding:8px 15px;
border-radius:12px;
font-weight:bold;
margin-top:10px;
}

</style>

</head>
<body>

<div class="sidebar">

<img src="/images/church-logo.png" class="logo">

<div class="brand">
SoulSync
</div>

<div class="role">
Youth President
</div>

<div class="menu">

<a href="/dashboard">
🏠 Dashboard
</a>

<a href="/admin/announcements">
📢 Manage Announcements
</a>

<a href="/admin/events">
📅 Manage Events
</a>

<a href="/admin/prayer-requests">
🙏 Monitor Prayer Requests
</a>

<a href="/admin/music-classes">
🎵 Manage Music Classes
</a>

<a href="#">
👥 Manage Members
</a>

<a href="#">
📊 Analytics Reports
</a>

<a href="#">
📷 QR Attendance
</a>

<a href="#">
🎤 Worship Team
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<div class="main">

<div class="top-card">

<h1>Youth President Dashboard</h1>

<h4>
Welcome, <%= user.fullname %>
</h4>

<p>
You have full administrative access to the SoulSync ministry system.
</p>

<div class="admin-badge">
ADMINISTRATOR ACCESS
</div>

</div>

<div class="grid">

<div class="card">

<h5>Total Youth Members</h5>

<div class="value">
120
</div>

</div>

<div class="card">

<h5>Total Events Managed</h5>

<div class="value">
18
</div>

</div>

<div class="card">

<h5>Prayer Requests</h5>

<div class="value">
34
</div>

</div>

<div class="card">

<h5>Attendance Rate</h5>

<div class="value">
95%
</div>

</div>

</div>

<div class="section">

<h3>Administrative Controls</h3>

<div class="activity">
📢 Create and manage church announcements
</div>

<div class="activity">
📅 Create youth events and schedules
</div>

<div class="activity">
🙏 Monitor all prayer requests
</div>

<div class="activity">
🎵 Assign music class schedules
</div>

<div class="activity">
👥 Manage youth members
</div>

<div class="activity">
📊 View ministry analytics reports
</div>

</div>

</div>

</body>
</html>