<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youth President Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
overflow-x:hidden;
}

/* ===================================== */
/* SIDEBAR */
/* ===================================== */

.sidebar{

width:300px;

height:100vh;

position:fixed;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

padding:24px 18px;

overflow-y:auto;

border-right:
1px solid rgba(255,255,255,0.1);
}

.logo{
width:80px;
display:block;
margin:auto;
margin-bottom:10px;
}

.brand{
text-align:center;
font-size:26px;
font-weight:700;
margin-bottom:28px;
}

.role{
text-align:center;
background:#ffcc00;
color:black;
padding:10px;
border-radius:12px;
font-weight:600;
font-size:14px;
margin-bottom:26px;
}

/* ===================================== */
/* MENU */
/* ===================================== */

.menu a{

display:flex;
align-items:center;
gap:10px;

padding:14px 16px;

margin-bottom:12px;

border-radius:14px;

text-decoration:none;

color:white;

background:
rgba(255,255,255,0.08);

transition:0.3s;

font-size:13px;

font-weight:600;

white-space:nowrap;

overflow:hidden;

text-overflow:ellipsis;
}

.menu a:hover{
background:#ffcc00;
color:black;
transform:translateX(4px);
}

/* ===================================== */
/* MAIN */
/* ===================================== */

.main{
margin-left:320px;
padding:28px;
}

/* ===================================== */
/* TOP CARD */
/* ===================================== */

.top-card{

background:
rgba(255,255,255,0.10);

backdrop-filter:blur(12px);

padding:28px;

border-radius:24px;

margin-bottom:24px;

box-shadow:
0 6px 20px rgba(0,0,0,0.15);
}

.top-card h1{
font-size:32px;
font-weight:700;
margin-bottom:10px;
}

.top-card h4{
font-size:18px;
margin-bottom:10px;
}

.top-card p{
font-size:14px;
opacity:0.85;
line-height:1.6;
}

/* ===================================== */
/* ADMIN BADGE */
/* ===================================== */

.admin-badge{
background:#ffcc00;
color:black;
display:inline-block;
padding:8px 14px;
border-radius:10px;
font-weight:600;
font-size:13px;
margin-top:14px;
}

/* ===================================== */
/* ANALYTICS GRID */
/* ===================================== */

.grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
margin-bottom:24px;
}

/* ===================================== */
/* ANALYTICS CARDS */
/* ===================================== */

.card-box{

background:
rgba(255,255,255,0.10);

padding:22px;

border-radius:20px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;
}

.card-box:hover{
transform:translateY(-3px);
}

.card-box h5{
font-size:15px;
margin-bottom:12px;
font-weight:600;
}

/* ===================================== */
/* VALUES */
/* ===================================== */

.value{
font-size:32px;
font-weight:700;
color:#ffcc00;
}

/* ===================================== */
/* SECTION */
/* ===================================== */

.section{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:22px;

margin-bottom:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);
}

.section h3{
margin-bottom:18px;
font-size:22px;
font-weight:700;
}

/* ===================================== */
/* ACTIVITY */
/* ===================================== */

.activity{

background:
rgba(255,255,255,0.08);

padding:14px 16px;

border-radius:14px;

margin-bottom:12px;

font-size:14px;

display:flex;
align-items:center;
gap:10px;

transition:0.3s;
}

.activity:hover{
background:rgba(255,255,255,0.14);
}

/* ===================================== */
/* QUICK ACTIONS */
/* ===================================== */

.quick-actions{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.quick-card{

background:
rgba(255,255,255,0.08);

padding:22px;

border-radius:18px;

text-decoration:none;

color:white;

transition:0.3s;
}

.quick-card:hover{
background:#ffcc00;
color:black;
transform:translateY(-3px);
}

.quick-card h4{
font-size:18px;
margin-bottom:10px;
}

.quick-card p{
font-size:13px;
line-height:1.6;
opacity:0.85;
}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:992px){

.sidebar{
position:relative;
width:100%;
height:auto;
border-right:none;
}

.main{
margin-left:0;
padding:18px;
}

.grid{
grid-template-columns:1fr;
}

.quick-actions{
grid-template-columns:1fr;
}

.top-card h1{
font-size:26px;
}

}

</style>

</head>
<body>

<!-- ===================================== -->
<!-- SIDEBAR -->
<!-- ===================================== -->

<div class="sidebar">

<img src="church-logo.png" class="logo">

<div class="brand">
SoulSync
</div>

<div class="role">
Youth President
</div>

<div class="menu">

<a href="/dashboard">
🏠 Dashboard
</a>

<a href="/admin/announcements">
📢 Manage Announcements
</a>

<a href="/admin/events">
📅 Manage Events
</a>

<a href="/admin/prayer-request-list">
🙏 Prayer Requests
</a>

<a href="/admin/music-classes">
🎵 Music Classes
</a>

<a href="#">
👥 Manage Members
</a>

<a href="#">
📊 Analytics Reports
</a>

<a href="#">
📷 QR Attendance
</a>

<a href="#">
🎤 Worship Team
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<!-- ===================================== -->
<!-- MAIN -->
<!-- ===================================== -->

<div class="main">

<div class="top-card">

<h1>
Youth President Dashboard
</h1>

<h4>
Welcome, <%= user.fullname %>
</h4>

<p>
You have full administrative access to the SoulSync ministry platform including events, prayer monitoring, member activities, ministry scheduling, and church engagement management.
</p>

<div class="admin-badge">
ADMINISTRATOR ACCESS
</div>

</div>

<div class="grid">

<div class="card-box">

<h5>
👥 Total Youth Members
</h5>

<div class="value">
120
</div>

</div>

<div class="card-box">

<h5>
📅 Events Managed
</h5>

<div class="value">
18
</div>

</div>

<div class="card-box">

<h5>
🙏 Prayer Requests
</h5>

<div class="value">
34
</div>

</div>

<div class="card-box">

<h5>
📊 Attendance Rate
</h5>

<div class="value">
95%
</div>

</div>

</div>

<div class="section">

<h3>
⚡ Quick Actions
</h3>

<div class="quick-actions">

<a
href="/admin/events"
class="quick-card"
>

<h4>
📅 Manage Events
</h4>

<p>
Create, update, and organize ministry and fellowship activities.
</p>

</a>

<a
href="/admin/prayer-request-list"
class="quick-card"
>

<h4>
🙏 Prayer Monitoring
</h4>

<p>
Track prayer requests, testimonies, and community prayer support.
</p>

</a>

<a
href="/admin/announcements"
class="quick-card"
>

<h4>
📢 Announcements
</h4>

<p>
Post ministry updates, reminders, and church notices.
</p>

</a>

</div>

</div>

<div class="section">

<h3>
🛠 Administrative Controls
</h3>

<div class="activity">
📢 Create and manage church announcements
</div>

<div class="activity">
📅 Create youth events and schedules
</div>

<div class="activity">
🙏 Monitor all prayer requests and testimonies
</div>

<div class="activity">
🎵 Assign music class schedules
</div>

<div class="activity">
👥 Manage youth members and attendance
</div>

<div class="activity">
📊 View ministry analytics reports
</div>

<div class="activity">
📷 Track QR attendance system
</div>

<div class="activity">
🎤 Manage worship team assignments
</div>

</div>

</div>

</body>
</html>