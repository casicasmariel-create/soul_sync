<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Event Management</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
padding:32px;
}

/* ===================================== */
/* TOP BAR */
/* ===================================== */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:34px;

gap:18px;

flex-wrap:wrap;
}

.page-title{
font-size:40px;
font-weight:700;
margin:0;
line-height:1.1;
}

.button-group{
display:flex;
gap:12px;
flex-wrap:wrap;
}

/* ===================================== */
/* BUTTONS */
/* ===================================== */

.back-btn,
.create-btn{

padding:12px 18px;

border-radius:14px;

text-decoration:none;

font-weight:600;

font-size:14px;

transition:0.3s;

display:flex;
align-items:center;
gap:8px;
}

.back-btn{
background:#ffcc00;
color:black;
}

.create-btn{
background:#00d4ff;
color:black;
}

.back-btn:hover,
.create-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

/* ===================================== */
/* EVENT GRID */
/* ===================================== */

.events-wrapper{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(340px, 1fr));

gap:24px;
}

/* ===================================== */
/* EVENT CARD */
/* ===================================== */

.event-card{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

display:flex;
flex-direction:column;

transition:0.3s;
}

.event-card:hover{
transform:translateY(-3px);
}

/* ===================================== */
/* EVENT TITLE */
/* ===================================== */

.event-title{

font-size:28px;

font-weight:700;

color:#ffcc00;

margin-bottom:16px;

line-height:1.3;

word-break:break-word;
}

/* ===================================== */
/* DESCRIPTION */
/* ===================================== */

.event-description{

font-size:15px;

line-height:1.8;

margin-bottom:18px;

white-space:pre-line;

opacity:0.95;
}

/* ===================================== */
/* DATE */
/* ===================================== */

.event-date{

font-size:13px;

opacity:0.8;

margin-bottom:20px;

line-height:1.9;
}

/* ===================================== */
/* RESPONSE BOX */
/* ===================================== */

.response-box{

background:
rgba(255,255,255,0.08);

padding:14px;

border-radius:14px;

margin-bottom:18px;

font-size:13px;

line-height:1.7;
}

/* ===================================== */
/* ACTION BUTTONS */
/* ===================================== */

.action-buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:auto;
}

/* ===================================== */
/* BUTTONS */
/* ===================================== */

.edit-btn,
.delete-btn,
.view-response-btn{

padding:10px 15px;

border-radius:12px;

text-decoration:none;

font-weight:600;

font-size:13px;

transition:0.3s;
}

.edit-btn{
background:#00d4ff;
color:black;
}

.delete-btn{
background:#ff3b3b;
color:white;
}

.view-response-btn{
background:#9d4edd;
color:white;
}

.edit-btn:hover,
.delete-btn:hover,
.view-response-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:768px){

body{
padding:20px;
}

.page-title{
font-size:32px;
}

.top-bar{
align-items:flex-start;
}

.button-group{
width:100%;
}

.back-btn,
.create-btn{
width:100%;
justify-content:center;
}

.event-title{
font-size:24px;
}

.events-wrapper{
grid-template-columns:1fr;
}

}

</style>

</head>
<body>

<!-- ===================================== -->
<!-- TOP BAR -->
<!-- ===================================== -->

<div class="top-bar">

<h1 class="page-title">
📋 Event Management
</h1>

<div class="button-group">

<a href="/admin/events" class="create-btn">
➕ Create Event
</a>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

</div>

<!-- ===================================== -->
<!-- EVENT CARDS -->
<!-- ===================================== -->

<div class="events-wrapper">

<% events.forEach(event => { %>

<div class="event-card">

<!-- TITLE -->

<h2 class="event-title">
<%= event.title %>
</h2>

<!-- DESCRIPTION -->

<div class="event-description">
<%= event.description %>
</div>

<!-- DATE -->

<div class="event-date">

📅 <%= event.event_date %>

<br><br>

🕒

<%= new Date(
new Date(event.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

<!-- RESPONSE INFO -->

<div class="response-box">

👥 Event participation and attendance monitoring available through responses management.

</div>

<!-- ACTION BUTTONS -->

<div class="action-buttons">

<a
href="/admin/edit-event/<%= event.id %>"
class="edit-btn"
>
✏ Edit
</a>

<a
href="/admin/delete-event/<%= event.id %>"
class="delete-btn"
onclick="return confirm('Delete this event?')"
>
🗑 Delete
</a>

<a
href="/admin/event-responses/<%= event.id %>"
class="view-response-btn"
>
📋 Responses
</a>

</div>

</div>

<% }) %>

</div>

</body>
</html>