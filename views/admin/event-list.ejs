<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Event List</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:40px;
}

.page-title{
font-size:50px;
font-weight:bold;
}

.button-group{
display:flex;
gap:10px;
flex-wrap:wrap;
}

.back-btn,
.create-btn{
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.back-btn{
background:#ffcc00;
color:black;
}

.create-btn{
background:#00d4ff;
color:black;
}

.back-btn:hover,
.create-btn:hover{
background:white;
transform:scale(1.03);
}

.events-wrapper{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(350px, 420px));

justify-content:center;

gap:30px;

}

.event-card{

background:rgba(255,255,255,0.1);

padding:28px;

border-radius:28px;

backdrop-filter:blur(10px);

box-shadow:0 8px 25px rgba(0,0,0,0.15);

display:flex;
flex-direction:column;
}

.event-title{
font-size:32px;
font-weight:bold;
color:#ffcc00;
margin-bottom:14px;
line-height:1.2;
}

.event-description{
font-size:18px;
line-height:1.6;
margin-bottom:14px;
white-space:pre-line;
}

.event-date{
font-size:15px;
opacity:0.8;
margin-bottom:20px;
line-height:1.8;
}

.action-buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:auto;
}

.edit-btn,
.delete-btn,
.view-response-btn{
padding:10px 16px;
border-radius:12px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.edit-btn{
background:#00d4ff;
color:black;
}

.delete-btn{
background:#ff3b3b;
color:white;
}

.view-response-btn{
background:#9d4edd;
color:white;
}

.edit-btn:hover,
.delete-btn:hover,
.view-response-btn:hover{
background:white;
color:black;
transform:scale(1.03);
}

@media(max-width:768px){

body{
padding:20px;
}

.page-title{
font-size:36px;
}

.events-wrapper{
grid-template-columns:1fr;
}

.event-title{
font-size:28px;
}

}

</style>

</head>
<body>

<div class="top-bar">

<h1 class="page-title">
📋 Event List
</h1>

<div class="button-group">

<a href="/admin/events" class="create-btn">
➕ Create Event
</a>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

</div>

<div class="events-wrapper">

<% events.forEach(event => { %>

<div class="event-card">

<h2 class="event-title">
<%= event.title %>
</h2>

<div class="event-description">
<%= event.description %>
</div>

<div class="event-date">

📅 <%= event.event_date %>

<br><br>

🕒

<%= new Date(
new Date(event.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

<div class="action-buttons">

<a
href="/admin/edit-event/<%= event.id %>"
class="edit-btn"
>
✏ Edit
</a>

<a
href="/admin/delete-event/<%= event.id %>"
class="delete-btn"
onclick="return confirm('Delete this event?')"
>
🗑 Delete
</a>

<a
href="/admin/event-responses/<%= event.id %>"
class="view-response-btn"
>
📋 Responses
</a>

</div>

</div>

<% }) %>

</div>

</body>
</html>