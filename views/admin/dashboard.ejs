<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Youth President Dashboard
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

/* ===================================== */
/* GLOBAL */
/* ===================================== */

*{

margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;

}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
overflow-x:hidden;

}

/* ===================================== */
/* SIDEBAR */
/* ===================================== */

.sidebar{

width:300px;
height:100vh;

position:fixed;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

padding:24px 18px;

overflow-y:auto;

border-right:
1px solid rgba(255,255,255,0.1);

}

/* ===================================== */
/* LOGO */
/* ===================================== */

.logo{

width:90px;

display:block;

margin:auto;

margin-bottom:10px;

}

/* ===================================== */
/* BRAND */
/* ===================================== */

.brand{

text-align:center;

font-size:34px;

font-weight:700;

margin-bottom:28px;

}

/* ===================================== */
/* ROLE */
/* ===================================== */

.role{

text-align:center;

background:#ffcc00;

color:black;

padding:12px;

border-radius:14px;

font-weight:700;

font-size:14px;

margin-bottom:26px;

}

/* ===================================== */
/* MENU */
/* ===================================== */

.menu a{

display:flex;

align-items:center;

gap:10px;

padding:14px 16px;

margin-bottom:12px;

border-radius:14px;

text-decoration:none;

color:white;

background:
rgba(255,255,255,0.08);

transition:0.3s;

font-size:14px;

font-weight:600;

}

.menu a:hover{

background:#ffcc00;

color:black;

transform:translateX(4px);

}

/* ===================================== */
/* MAIN */
/* ===================================== */

.main{

margin-left:320px;

padding:28px;

}

/* ===================================== */
/* TOP CARD */
/* ===================================== */

.top-card{

background:
rgba(255,255,255,0.10);

backdrop-filter:blur(12px);

padding:28px;

border-radius:24px;

margin-bottom:24px;

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

}

.top-card h1{

font-size:40px;

font-weight:700;

margin-bottom:10px;

}

.top-card h4{

font-size:22px;

margin-bottom:10px;

}

.top-card p{

font-size:14px;

opacity:0.85;

line-height:1.7;

}

/* ===================================== */
/* DATE */
/* ===================================== */

.date-time{

margin-top:14px;

font-size:14px;

opacity:0.85;

}

/* ===================================== */
/* ADMIN BADGE */
/* ===================================== */

.admin-badge{

background:#ffcc00;

color:black;

display:inline-block;

padding:10px 16px;

border-radius:12px;

font-weight:700;

font-size:13px;

margin-top:14px;

}

/* ===================================== */
/* GRID */
/* ===================================== */

.grid{

display:grid;

grid-template-columns:
repeat(4,1fr);

gap:18px;

margin-top:20px;

}

/* ===================================== */
/* CARD */
/* ===================================== */

.card-box{

background:
rgba(255,255,255,0.10);

padding:22px;

border-radius:20px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;

}

.card-box:hover{

transform:translateY(-4px);

box-shadow:
0 0 20px rgba(255,204,0,0.15);

}

.card-box h5{

font-size:15px;

margin-bottom:12px;

font-weight:600;

}

/* ===================================== */
/* VALUE */
/* ===================================== */

.value{

font-size:34px;

font-weight:700;

color:#ffcc00;

margin-bottom:8px;

}

/* ===================================== */
/* SECTION */
/* ===================================== */

.section{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:22px;

margin-bottom:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

}

.section h3{

margin-bottom:18px;

font-size:24px;

font-weight:700;

}

/* ===================================== */
/* QUICK ACTIONS */
/* ===================================== */

.quick-actions{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:18px;

}

/* ===================================== */
/* QUICK CARD */
/* ===================================== */

.quick-card{

background:
rgba(255,255,255,0.08);

padding:22px;

border-radius:18px;

text-decoration:none;

color:white;

transition:0.3s;

}

.quick-card:hover{

background:#ffcc00;

color:black;

transform:translateY(-3px);

}

.quick-card h4{

font-size:18px;

margin-bottom:10px;

}

.quick-card p{

font-size:13px;

line-height:1.6;

opacity:0.85;

}

/* ===================================== */
/* ACTIVITY */
/* ===================================== */

.activity{

background:
rgba(255,255,255,0.08);

padding:14px 16px;

border-radius:14px;

margin-bottom:12px;

font-size:14px;

display:flex;

align-items:center;

gap:10px;

transition:0.3s;

}

.activity:hover{

background:
rgba(255,255,255,0.14);

}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:992px){

.sidebar{

position:relative;

width:100%;

height:auto;

border-right:none;

}

.main{

margin-left:0;

padding:18px;

}

.grid{

grid-template-columns:1fr;

}

.quick-actions{

grid-template-columns:1fr;

}

.top-card h1{

font-size:28px;

}

}

</style>

</head>

<body>

<!-- ===================================== -->
<!-- SIDEBAR -->
<!-- ===================================== -->

<div class="sidebar">

<img
src="church-logo.png"
class="logo"
>

<div class="brand">
SoulSync
</div>

<div class="role">
Youth President
</div>

<div class="menu">

<a href="/dashboard">
🏠 Dashboard
</a>

<a href="/admin/announcements">
📢 Manage Announcements
</a>

<a href="/admin/events">
📅 Manage Events
</a>

<a href="/admin/prayer-request-list">
🙏 Prayer Requests
</a>

<a href="/admin/music-classes">
🎵 Music Classes
</a>

<a href="/admin/manage-members">
👥 Manage Members
</a>

<a href="/logout">
🚪 Logout
</a>

</div>

</div>

<!-- ===================================== -->
<!-- MAIN -->
<!-- ===================================== -->

<div class="main">

<div class="top-card">

<h1>
Youth President Dashboard
</h1>

<h4>
Welcome, <%= user.fullname %>
</h4>

<p>
You have full administrative access to the SoulSync ministry platform including events, prayer monitoring, member activities, ministry scheduling, and church engagement management.
</p>

<div class="date-time">

📅
<%= new Date().toLocaleDateString() %>

•

⏰
<%= new Date().toLocaleTimeString() %>

</div>

<div class="admin-badge">
ADMINISTRATOR ACCESS
</div>

</div>

<!-- ===================================== -->
<!-- LIVE MINISTRY OVERVIEW -->
<!-- ===================================== -->

<div class="section">

<h3>
📊 Live Ministry Overview
</h3>

<div class="grid">

<div class="card-box">

<h5>
👥 Total Youth Members
</h5>

<div class="value">
<%= totalMembers %>
</div>

<p>
Registered church youth members
</p>

</div>

<div class="card-box">

<h5>
🎵 Active Music Classes
</h5>

<div class="value">
<%= totalMusicClasses %>
</div>

<p>
Current ministry training classes
</p>

</div>

<div class="card-box">

<h5>
📅 Upcoming Events
</h5>

<div class="value">
<%= totalEvents %>
</div>

<p>
Church and fellowship activities
</p>

</div>

<div class="card-box">

<h5>
🙏 Prayer Requests
</h5>

<div class="value">
<%= totalPrayers %>
</div>

<p>
Community prayer monitoring
</p>

</div>

</div>

</div>

</div>

</body>
</html>