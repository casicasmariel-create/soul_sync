<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Manage Members
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

}

/* ===================================== */
/* TOP BAR */
/* ===================================== */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:25px;

flex-wrap:wrap;

gap:10px;

}

/* ===================================== */
/* TITLE */
/* ===================================== */

.page-title{

font-size:32px;

font-weight:700;

}

/* ===================================== */
/* BACK BUTTON */
/* ===================================== */

.back-btn{

background:#ffcc00;

color:black;

padding:10px 18px;

border-radius:12px;

text-decoration:none;

font-weight:700;

}

/* ===================================== */
/* STATS CARD */
/* ===================================== */

.stats-card{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:20px;

margin-bottom:20px;

backdrop-filter:blur(10px);

}

/* ===================================== */
/* TOTAL NUMBER */
/* ===================================== */

.stats-number{

font-size:42px;

font-weight:700;

color:#ffcc00;

}

/* ===================================== */
/* TABLE CONTAINER */
/* ===================================== */

.table-box{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:24px;

backdrop-filter:blur(10px);

overflow-x:auto;

}

/* ===================================== */
/* TABLE */
/* ===================================== */

table{

width:100%;

border-collapse:collapse;

}

/* ===================================== */
/* TABLE HEADER */
/* ===================================== */

th{

background:
rgba(255,255,255,0.08);

padding:14px;

color:#ffcc00;

font-size:14px;

}

/* ===================================== */
/* TABLE DATA */
/* ===================================== */

td{

padding:14px;

border-bottom:
1px solid rgba(255,255,255,0.08);

font-size:14px;

}

/* ===================================== */
/* DELETE BUTTON */
/* ===================================== */

.delete-btn{

background:#dc3545;

color:white;

padding:8px 14px;

border-radius:10px;

text-decoration:none;

font-size:13px;

font-weight:700;

}

.delete-btn:hover{

background:#ff4d5a;

}

</style>

</head>

<body>

<!-- ===================================== -->
<!-- TOP BAR -->
<!-- ===================================== -->

<div class="top-bar">

<h1 class="page-title">
👥 Manage Members
</h1>

<a
href="/dashboard"
class="back-btn"
>

← Back Dashboard

</a>

</div>

<!-- ===================================== -->
<!-- TOTAL MEMBERS -->
<!-- ===================================== -->

<div class="stats-card">

<h5>
Total Registered Members
</h5>

<div class="stats-number">
<%= members.length %>
</div>

</div>

<!-- ===================================== -->
<!-- MEMBER TABLE -->
<!-- ===================================== -->

<div class="table-box">

<table>

<thead>

<tr>

<th>#</th>
<th>Full Name</th>
<th>Email</th>
<th>Role</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% members.forEach((member, index) => { %>

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<%= member.fullname %>
</td>

<td>
<%= member.email %>
</td>

<td>
<%= member.role %>
</td>

<td>

<a
href="/admin/delete-member/<%= member.id %>"
class="delete-btn"
onclick="return confirm('Delete this member?')"
>

Delete

</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</body>
</html>