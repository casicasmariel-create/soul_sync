<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Prayer Request Management
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;

min-height:100vh;

padding:24px;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

margin-bottom:22px;

}

.page-title{

font-size:28px;

font-weight:700;

}

/* DASHBOARD BUTTON */

.back-btn{

background:#ffcc00;

color:black;

padding:10px 16px;

border-radius:10px;

text-decoration:none;

font-weight:600;

font-size:14px;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* ANALYTICS */

.analytics-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(180px,1fr));

gap:14px;

margin-bottom:22px;

}

.analytics-card{

padding:14px 16px;

border-radius:16px;

min-height:95px;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

font-weight:600;

box-shadow:
0 3px 10px rgba(0,0,0,0.15);

}

.analytics-card h4{

font-size:15px;

margin-bottom:6px;

font-weight:600;

}

.analytics-card h1{

font-size:30px;

font-weight:700;

margin:0;

line-height:1;

}

/* CARD COLORS */

.total-card{

background:#ffc107;

color:black;

}

.praying-card{

background:#0d6efd;

color:white;

}

.answered-card{

background:#198754;

color:white;

}

.support-card{

background:#dc3545;

color:white;

}

/* FILTER */

.filter-box{

display:flex;

gap:12px;

flex-wrap:wrap;

margin-bottom:22px;

}

.filter-box input,
.filter-box select{

padding:11px 14px;

border:none;

outline:none;

border-radius:12px;

font-size:14px;

}

.search-input{

width:280px;

}

/* TABLE CONTAINER */

.table-container{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:22px;

backdrop-filter:blur(10px);

overflow-x:auto;

box-shadow:
0 6px 18px rgba(0,0,0,0.15);

}

/* TABLE */

.table{

margin-bottom:0;

border-radius:14px;

overflow:hidden;

}

/* TABLE HEADER */

.table th{

background:#2c003e !important;

color:#ffcc00 !important;

padding:14px;

text-align:center;

font-size:14px;

font-weight:700;

white-space:nowrap;

}

/* TABLE BODY */

.table td{

padding:16px 14px;

vertical-align:top;

font-size:14px;

background:
rgba(18,18,18,0.82);

color:#f1f1f1;

line-height:1.5;

}

/* CATEGORY */

.category-badge{

background:#00d4ff;

color:black;

padding:7px 14px;

border-radius:10px;

font-weight:700;

font-size:13px;

display:inline-block;

}

/* STATUS */

.status-badge{

padding:7px 14px;

border-radius:10px;

font-size:13px;

font-weight:700;

display:inline-block;

}

.status-praying{

background:#0dcaf0;

color:black;

}

.status-answered{

background:#198754;

color:white;

}

/* DELETE BUTTON */

.delete-btn{

background:#dc3545;

border:none;

padding:9px 14px;

border-radius:10px;

font-weight:600;

font-size:13px;

color:white;

text-decoration:none;

transition:0.3s;

display:inline-block;

}

.delete-btn:hover{

background:#ff5a6b;

transform:translateY(-2px);

}

/* PRAYER TITLE */

.prayer-title{

font-size:16px;

font-weight:700;

line-height:1.5;

margin-bottom:14px;

color:#ffffff;

}

/* INFO CARD */

.info-card{

background:
rgba(255,255,255,0.06);

padding:14px;

border-radius:12px;

margin-bottom:12px;

border-left:4px solid #00d4ff;

}

.info-title{

font-size:14px;

font-weight:700;

margin-bottom:8px;

color:#00d4ff;

}

.support-count{

font-size:13px;

color:#f1f1f1;

margin-bottom:8px;

}

/* SUPPORTERS */

.supporters{

display:flex;

flex-wrap:wrap;

gap:7px;

}

.supporter-name{

background:#37104d;

padding:5px 10px;

border-radius:18px;

font-size:12px;

color:white;

border:
1px solid rgba(255,255,255,0.1);

}

/* TESTIMONY */

.testimony-card{

background:
rgba(25,135,84,0.12);

border-left:4px solid #198754;

padding:14px;

border-radius:12px;

}

.testimony-title{

font-size:14px;

font-weight:700;

margin-bottom:8px;

color:#7dffb3;

}

.testimony-text{

font-size:13px;

line-height:1.6;

font-style:italic;

color:#f1f1f1;

}

/* RESPONSIVE */

@media(max-width:768px){

body{
padding:16px;
}

.page-title{
font-size:24px;
}

.search-input{
width:100%;
}

.table th,
.table td{

font-size:12px;

padding:12px;

}

.analytics-card h1{

font-size:24px;

}

}

</style>

</head>

<body>

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
🙏 Prayer Request Management
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- ANALYTICS -->

<div class="analytics-grid">

<div class="analytics-card total-card">

<h4>
🙏 Total Requests
</h4>

<h1>
<%= total %>
</h1>

</div>

<div class="analytics-card praying-card">

<h4>
🙏 Still Praying
</h4>

<h1>
<%= praying %>
</h1>

</div>

<div class="analytics-card answered-card">

<h4>
✨ Answered
</h4>

<h1>
<%= answered %>
</h1>

</div>

<div class="analytics-card support-card">

<h4>
🔥 Supporters
</h4>

<h1>
<%= supporters %>
</h1>

</div>

</div>

<!-- FILTER -->

<div class="filter-box">

<input
type="text"
id="searchInput"
class="search-input"
placeholder="Search prayer requests..."
>

<select id="statusFilter">

<option value="">
All Status
</option>

<option value="Still Praying">
Still Praying
</option>

<option value="Answered Prayer">
Answered Prayer
</option>

</select>

<select id="categoryFilter">

<option value="">
All Categories
</option>

<option value="Healing">
Healing
</option>

<option value="Family">
Family
</option>

<option value="Studies">
Studies
</option>

<option value="Financial">
Financial
</option>

<option value="Thanksgiving">
Thanksgiving
</option>

<option value="Guidance">
Guidance
</option>

<option value="Ministry">
Ministry
</option>

<option value="Personal">
Personal
</option>

</select>

</div>

<!-- TABLE -->

<div class="table-container">

<table class="table table-bordered align-middle">

<thead>

<tr>

<th>#</th>

<th>Full Name</th>

<th>Prayer Request</th>

<th>Category</th>

<th>Status</th>

<th>Date & Time</th>

<th>Actions</th>

</tr>

</thead>

<tbody>

<% prayers.forEach((prayer, index) => { %>

<tr
data-status="<%= prayer.status %>"
data-category="<%= prayer.category %>"
>

<!-- NUMBER -->

<td class="text-center">

<%= index + 1 %>

</td>

<!-- FULL NAME -->

<td>

<% if(prayer.anonymous === 'YES'){ %>

🙏 Anonymous User

<% } else { %>

<%= prayer.fullname || 'Unknown User' %>

<% } %>

</td>

<!-- PRAYER -->

<td>

<div class="prayer-title">
<%= prayer.prayer %>
</div>

<!-- SUPPORT -->

<div class="info-card">

<div class="info-title">
🙏 Prayer Support
</div>

<div class="support-count">

<strong>
<%= prayer.support_count || 0 %>
</strong>

people prayed for this request

</div>

<% if(
prayer.supporters &&
prayer.supporters.length > 0
){ %>

<div class="supporters">

<% prayer.supporters.forEach(person => { %>

<div class="supporter-name">

<%= person.fullname %>

</div>

<% }) %>

</div>

<% } else { %>

<div style="font-size:12px; color:#aaa;">
No supporters yet
</div>

<% } %>

</div>

<!-- TESTIMONY -->

<% if(
prayer.status === 'Answered Prayer'
&& prayer.testimony
){ %>

<div class="testimony-card">

<div class="testimony-title">
✨ Testimony
</div>

<div class="testimony-text">

"<%= prayer.testimony %>"

</div>

</div>

<% } %>

</td>

<!-- CATEGORY -->

<td class="text-center">

<span class="category-badge">

<%= prayer.category %>

</span>

</td>

<!-- STATUS -->

<td class="text-center">

<% if(
prayer.status === 'Still Praying'
){ %>

<span class="status-badge status-praying">
🙏 Still Praying
</span>

<% } else { %>

<span class="status-badge status-answered">
✨ Answered Prayer
</span>

<% } %>

</td>

<!-- DATE -->

<td>

<%= new Date(
new Date(prayer.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'short',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</td>

<!-- ACTION -->

<td class="text-center">

<a
href="/admin/delete-prayer/<%= prayer.id %>"
class="delete-btn"
onclick="
return confirm(
'Delete this prayer request?'
)
"
>
🗑 Delete
</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<!-- FILTER SCRIPT -->

<script>

const searchInput =
document.getElementById(
'searchInput'
);

const statusFilter =
document.getElementById(
'statusFilter'
);

const categoryFilter =
document.getElementById(
'categoryFilter'
);

const rows =
document.querySelectorAll(
'tbody tr'
);

function filterTable(){

const search =
searchInput.value.toLowerCase();

const status =
statusFilter.value;

const category =
categoryFilter.value;

rows.forEach(row => {

const text =
row.innerText.toLowerCase();

const rowStatus =
row.dataset.status;

const rowCategory =
row.dataset.category;

const matchesSearch =
text.includes(search);

const matchesStatus =
!status ||
rowStatus === status;

const matchesCategory =
!category ||
rowCategory === category;

if(
matchesSearch &&
matchesStatus &&
matchesCategory
){

row.style.display = '';

}else{

row.style.display = 'none';

}

});

}

searchInput.addEventListener(
'keyup',
filterTable
);

statusFilter.addEventListener(
'change',
filterTable
);

categoryFilter.addEventListener(
'change',
filterTable
);

</script>

</body>
</html>