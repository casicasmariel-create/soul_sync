<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Prayer Request List</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:35px;
flex-wrap:wrap;
gap:15px;
}

.page-title{
font-size:50px;
font-weight:bold;
}

.button-group{
display:flex;
gap:10px;
flex-wrap:wrap;
}

.back-btn,
.create-btn{
padding:12px 22px;
border-radius:14px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.back-btn{
background:#ffcc00;
color:black;
}

.create-btn{
background:#00d4ff;
color:black;
}

.back-btn:hover,
.create-btn:hover{
background:white;
transform:scale(1.03);
}

.filter-box{
display:flex;
gap:15px;
flex-wrap:wrap;
margin-bottom:25px;
}

.filter-box input,
.filter-box select{
padding:14px;
border:none;
border-radius:14px;
outline:none;
}

.search-input{
width:320px;
}

.table-box{
background:rgba(255,255,255,0.08);
padding:30px;
border-radius:30px;
backdrop-filter:blur(10px);
box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

.table{
margin-bottom:0;
border-radius:18px;
overflow:hidden;
}

.table th{
background:#2c003e !important;
color:#ffcc00 !important;
padding:18px;
text-align:center;
font-size:18px;
}

.table td{
padding:18px;
vertical-align:middle;
font-size:16px;
}

.prayer-content{
white-space:pre-line;
line-height:1.6;
}

.date{
font-size:14px;
opacity:0.8;
}

.category-badge{
background:#00d4ff;
color:black;
padding:8px 12px;
border-radius:10px;
font-weight:bold;
display:inline-block;
}

.status-btn{
margin-top:10px;
}

.delete-btn{
margin-top:8px;
}

@media(max-width:768px){

body{
padding:20px;
}

.page-title{
font-size:38px;
}

.table th,
.table td{
font-size:14px;
padding:12px;
}

.search-input{
width:100%;
}

}

</style>

</head>
<body>

<div class="top-bar">

<h1 class="page-title">
🙏 Prayer Request List
</h1>

<div class="button-group">

<a href="/admin/prayer-requests" class="create-btn">
➕ Create Prayer
</a>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

</div>

<div class="filter-box">

<input
type="text"
id="searchInput"
placeholder="Search prayer requests..."
class="search-input"
>

<select id="statusFilter">

<option value="">
All Status
</option>

<option value="Pending Prayer">
Pending Prayer
</option>

<option value="Currently Praying">
Currently Praying
</option>

<option value="Answered Prayer">
Answered Prayer
</option>

</select>

<select id="categoryFilter">

<option value="">
All Categories
</option>

<option value="Healing">
Healing
</option>

<option value="Family">
Family
</option>

<option value="Studies">
Studies
</option>

<option value="Financial">
Financial
</option>

<option value="Thanksgiving">
Thanksgiving
</option>

<option value="Guidance">
Guidance
</option>

<option value="Ministry">
Ministry
</option>

<option value="Personal">
Personal
</option>

</select>

</div>

<div class="table-box">

<table class="table table-dark table-bordered align-middle">

<thead>

<tr>

<th style="width:50px;">
#
</th>

<th style="width:220px;">
Full Name
</th>

<th>
Prayer Request
</th>

<th style="width:180px;">
Category
</th>

<th style="width:220px;">
Status
</th>

<th style="width:220px;">
Date & Time
</th>

<th style="width:170px;">
Actions
</th>

</tr>

</thead>

<tbody>

<% prayers.forEach((prayer, index) => { %>

<tr
data-status="<%= prayer.status %>"
data-category="<%= prayer.category %>"
>

<td class="text-center">
<%= index + 1 %>
</td>

<td>

<% if(prayer.anonymous === 'YES'){ %>

🙏 Anonymous User

<% } else { %>

<%= prayer.fullname || 'Unknown User' %>

<% } %>

</td>

<td>

<div class="prayer-content">
<%= prayer.prayer %>
</div>

</td>

<td class="text-center">

<span class="category-badge">
<%= prayer.category %>
</span>

</td>

<td class="text-center">

<% if(prayer.status === 'Pending Prayer'){ %>

<span class="badge bg-warning text-dark p-2">
⏳ Pending Prayer
</span>

<br>

<a
href="/admin/update-prayer-status/<%= prayer.id %>/Currently Praying"
class="btn btn-info btn-sm status-btn"
>
Start Praying
</a>

<% } else if(prayer.status === 'Currently Praying'){ %>

<span class="badge bg-info text-dark p-2">
🙏 Currently Praying
</span>

<br>

<a
href="/admin/update-prayer-status/<%= prayer.id %>/Answered Prayer"
class="btn btn-success btn-sm status-btn"
>
Mark Answered
</a>

<% } else { %>

<span class="badge bg-success p-2">
✅ Answered Prayer
</span>

<% } %>

</td>

<td>

<div class="date">

🕒

<%= new Date(
new Date(prayer.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

</td>

<td class="text-center">

<a
href="/admin/delete-prayer/<%= prayer.id %>"
class="btn btn-danger btn-sm delete-btn"
onclick="return confirm('Delete this prayer request?')"
>
🗑 Delete
</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<script>

const searchInput =
document.getElementById('searchInput');

const statusFilter =
document.getElementById('statusFilter');

const categoryFilter =
document.getElementById('categoryFilter');

const rows =
document.querySelectorAll('tbody tr');

function filterTable(){

const search =
searchInput.value.toLowerCase();

const status =
statusFilter.value;

const category =
categoryFilter.value;

rows.forEach(row => {

const text =
row.innerText.toLowerCase();

const rowStatus =
row.dataset.status;

const rowCategory =
row.dataset.category;

const matchesSearch =
text.includes(search);

const matchesStatus =
!status || rowStatus === status;

const matchesCategory =
!category || rowCategory === category;

if(
matchesSearch &&
matchesStatus &&
matchesCategory
){
row.style.display = '';
}else{
row.style.display = 'none';
}

});

}

searchInput.addEventListener(
'keyup',
filterTable
);

statusFilter.addEventListener(
'change',
filterTable
);

categoryFilter.addEventListener(
'change',
filterTable
);

</script>

</body>
</html>