<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Music Classes Management
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

margin-bottom:30px;

}

.page-title{

font-size:42px;
font-weight:700;

}

.back-btn{

background:#ffcc00;
color:black;

padding:12px 20px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* ANALYTICS */

.analytics-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(220px,1fr));

gap:20px;

margin-bottom:30px;

}

.analytics-card{

padding:25px;

border-radius:24px;

text-align:center;

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

}

.analytics-card h4{

font-size:16px;

margin-bottom:10px;

}

.analytics-card h1{

font-size:42px;

font-weight:700;

}

.total-card{
background:#ffc107;
color:black;
}

.trainer-card{
background:#00d4ff;
color:black;
}

.schedule-card{
background:#198754;
}

.ministry-card{
background:#dc3545;
}

/* MAIN GRID */

.main-grid{

display:grid;

grid-template-columns:
400px 1fr;

gap:25px;

align-items:start;

}

/* FORM BOX */

.form-box{

background:
rgba(255,255,255,0.08);

padding:30px;

border-radius:28px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

position:sticky;
top:20px;

}

/* SECTION TITLE */

.section-title{

font-size:26px;

font-weight:700;

margin-bottom:24px;

color:#ffcc00;

}

/* FORM */

.form-label{

font-weight:600;

margin-bottom:8px;

}

.form-control,
.form-select{

padding:14px;

border:none;

border-radius:14px;

margin-bottom:18px;

}

textarea{

resize:none;
height:150px;

}

/* BUTTON */

.create-btn{

width:100%;

background:#00d4ff;
color:black;

border:none;

padding:14px;

border-radius:14px;

font-size:16px;

font-weight:700;

transition:0.3s;

}

.create-btn:hover{

background:white;

transform:translateY(-2px);

}

/* CLASS LIST */

.classes-box{

background:
rgba(255,255,255,0.08);

padding:30px;

border-radius:28px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

}

/* CLASS CARD */

.class-card{

background:
rgba(255,255,255,0.05);

padding:24px;

border-radius:24px;

margin-bottom:24px;

border:
1px solid rgba(255,255,255,0.08);

transition:0.3s;

}

.class-card:hover{

transform:translateY(-3px);

background:
rgba(255,255,255,0.08);

}

/* TOP */

.class-top{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

margin-bottom:18px;

}

.class-title{

font-size:28px;

font-weight:700;

color:#ffcc00;

line-height:1.5;

}

/* CATEGORY */

.category-badge{

background:#00d4ff;
color:black;

padding:8px 14px;

border-radius:20px;

font-size:13px;

font-weight:700;

}

/* INFO GRID */

.class-info{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(220px,1fr));

gap:15px;

margin-bottom:18px;

}

/* INFO CARD */

.info-card{

background:
rgba(255,255,255,0.05);

padding:15px;

border-radius:16px;

}

.info-title{

font-size:13px;

color:#bbb;

margin-bottom:5px;

}

.info-value{

font-size:15px;

font-weight:600;

line-height:1.6;

}

/* DESCRIPTION */

.class-description{

background:
rgba(255,255,255,0.04);

padding:16px;

border-radius:16px;

line-height:1.8;

margin-bottom:20px;

color:#f1f1f1;

}

/* BUTTONS */

.action-buttons{

display:flex;

gap:12px;

flex-wrap:wrap;

}

.edit-btn,
.delete-btn{

padding:11px 18px;

border-radius:14px;

text-decoration:none;

font-weight:700;

font-size:14px;

transition:0.3s;

}

.edit-btn{

background:#00d4ff;
color:black;

}

.delete-btn{

background:#dc3545;
color:white;

}

.edit-btn:hover,
.delete-btn:hover{

background:white;
color:black;

transform:translateY(-2px);

}

/* EMPTY */

.empty-box{

text-align:center;

padding:60px 20px;

opacity:0.7;

}

/* RESPONSIVE */

@media(max-width:992px){

.main-grid{
grid-template-columns:1fr;
}

.form-box{
position:relative;
top:0;
}

}

@media(max-width:768px){

body{
padding:18px;
}

.page-title{
font-size:32px;
}

.class-title{
font-size:24px;
}

.analytics-card h1{
font-size:32px;
}

}

</style>

</head>

<body>

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
🎵 Music Classes Management
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- ANALYTICS -->

<div class="analytics-grid">

<div class="analytics-card total-card">

<h4>
🎵 Total Classes
</h4>

<h1>
<%= totalClasses || 0 %>
</h1>

</div>

<div class="analytics-card trainer-card">

<h4>
👨‍🏫 Trainers
</h4>

<h1>
<%= trainers || 0 %>
</h1>

</div>

<div class="analytics-card schedule-card">

<h4>
📅 Schedules
</h4>

<h1>
<%= schedules || 0 %>
</h1>

</div>

<div class="analytics-card ministry-card">

<h4>
🎶 Active Ministry
</h4>

<h1>
<%= classes.length || 0 %>
</h1>

</div>

</div>

<!-- MAIN GRID -->

<div class="main-grid">

<!-- FORM -->

<div class="form-box">

<h2 class="section-title">
➕ Create Music Class
</h2>

<form
action="/admin/create-music-class"
method="POST"
>

<!-- CLASS NAME -->

<label class="form-label">
Class Name
</label>

<input
type="text"
name="class_name"
class="form-control"
placeholder="Example: Worship Guitar Basics"
required
>

<!-- TRAINER -->

<label class="form-label">
Trainer / Instructor
</label>

<input
type="text"
name="trainer"
class="form-control"
placeholder="Enter trainer name"
required
>

<!-- CATEGORY -->

<label class="form-label">
Category
</label>

<select
name="category"
class="form-select"
required
>

<option value="">
Select Category
</option>

<option>
Acoustic Guitar
</option>

<option>
Electric Guitar
</option>

<option>
Keyboard & Piano
</option>

<option>
Drums & Rhythm
</option>

<option>
Bass Guitar
</option>

<option>
Worship Vocals
</option>

<option>
Worship Leading
</option>

<option>
Multimedia Ministry
</option>

<option>
Sound System Training
</option>

</select>

<!-- SCHEDULE -->

<label class="form-label">
Schedule
</label>

<input
type="text"
name="schedule"
class="form-control"
placeholder="Example: Saturday 3:00 PM"
required
>

<!-- LOCATION -->

<label class="form-label">
Location
</label>

<input
type="text"
name="location"
class="form-control"
placeholder="Example: Church Main Hall"
required
>

<!-- DESCRIPTION -->

<label class="form-label">
Description
</label>

<textarea
name="description"
class="form-control"
placeholder="Enter class description..."
required
></textarea>

<!-- BUTTON -->

<button
type="submit"
class="create-btn"
>
🎵 Create Music Class
</button>

</form>

</div>

<!-- CLASS LIST -->

<div class="classes-box">

<h2 class="section-title">
📋 Music Class List
</h2>

<% if(classes && classes.length > 0){ %>

<% classes.forEach(item => { %>

<div class="class-card">

<!-- TOP -->

<div class="class-top">

<div class="class-title">

<%= item.class_name %>

</div>

<div class="category-badge">

<%= item.category %>

</div>

</div>

<!-- INFO -->

<div class="class-info">

<div class="info-card">

<div class="info-title">
👨‍🏫 Trainer
</div>

<div class="info-value">

<%= item.trainer %>

</div>

</div>

<div class="info-card">

<div class="info-title">
📅 Schedule
</div>

<div class="info-value">

<%= item.schedule %>

</div>

</div>

<div class="info-card">

<div class="info-title">
📍 Location
</div>

<div class="info-value">

<%= item.location %>

</div>

</div>

</div>

<!-- DESCRIPTION -->

<div class="class-description">

<%= item.description %>

</div>

<!-- BUTTONS -->

<div class="action-buttons">

<a
href="/admin/edit-music-class/<%= item.id %>"
class="edit-btn"
>
✏ Edit
</a>

<a
href="/admin/delete-music-class/<%= item.id %>"
class="delete-btn"
onclick="
return confirm(
'Delete this music class?'
)
"
>
🗑 Delete
</a>

</div>

</div>

<% }) %>

<% } else { %>

<div class="empty-box">

<h3>
🎵 No Music Classes Yet
</h3>

<p>
Create your first ministry training class.
</p>

</div>

<% } %>

</div>

</div>

</body>
</html>