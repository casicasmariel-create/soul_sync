<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Music Classes Management
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:20px;

color:white;

}

/* MAIN */

.main-container{

max-width:1250px;

margin:auto;

}

/* TOP BAR */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:12px;

margin-bottom:20px;

}

/* TITLE */

.page-title{

font-size:30px;

font-weight:700;

display:flex;

align-items:center;

gap:12px;

}

/* BUTTON */

.back-btn{

background:#ffcc00;

color:black;

padding:9px 15px;

border-radius:10px;

text-decoration:none;

font-size:14px;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* ANALYTICS */

.analytics-grid{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(180px,1fr));

gap:12px;

margin-bottom:20px;

}

/* ANALYTICS CARD */

.analytics-card{

padding:12px;

border-radius:18px;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

min-height:90px;

box-shadow:
0 4px 10px rgba(0,0,0,0.15);

}

.analytics-card h4{

font-size:14px;

margin-bottom:5px;

}

.analytics-card h1{

font-size:28px;

font-weight:700;

margin:0;

}

/* COLORS */

.total-card{
background:#ffc107;
color:black;
}

.trainer-card{
background:#00cfff;
color:black;
}

.schedule-card{
background:#198754;
}

.ministry-card{
background:#dc3545;
}

/* GRID */

.main-grid{

display:grid;

grid-template-columns:
320px 1fr;

gap:18px;

align-items:start;

}

/* FORM */

.form-box{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:22px;

backdrop-filter:blur(10px);

}

/* TITLE */

.section-title{

font-size:22px;

font-weight:700;

margin-bottom:18px;

color:#ffcc00;

}

/* FORM LABEL */

.form-label{

font-size:14px;

font-weight:600;

margin-bottom:6px;

}

/* INPUT */

.form-control,
.form-select{

padding:12px;

border:none;

border-radius:12px;

margin-bottom:14px;

font-size:14px;

}

/* TEXTAREA */

textarea{

resize:none;

height:120px;

}

/* CREATE BUTTON */

.create-btn{

width:100%;

background:#00cfff;

color:black;

border:none;

padding:12px;

border-radius:12px;

font-size:14px;

font-weight:700;

transition:0.3s;

}

.create-btn:hover{

background:white;

transform:translateY(-2px);

}

/* CLASS BOX */

.classes-box{

background:
rgba(255,255,255,0.08);

padding:20px;

border-radius:22px;

backdrop-filter:blur(10px);

}

/* CLASS CARD */

.class-card{

background:
rgba(255,255,255,0.05);

padding:18px;

border-radius:20px;

margin-bottom:18px;

border:
1px solid rgba(255,255,255,0.08);

}

/* TOP */

.class-top{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:10px;

margin-bottom:15px;

}

/* CLASS NAME */

.class-title{

font-size:22px;

font-weight:700;

color:#ffcc00;

}

/* CATEGORY */

.category-badge{

background:#00cfff;

color:black;

padding:7px 14px;

border-radius:20px;

font-size:12px;

font-weight:700;

}

/* INFO GRID */

.class-info{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(200px,1fr));

gap:12px;

margin-bottom:14px;

}

/* INFO CARD */

.info-card{

background:
rgba(255,255,255,0.05);

padding:13px;

border-radius:14px;

}

.info-title{

font-size:12px;

color:#ccc;

margin-bottom:4px;

}

.info-value{

font-size:14px;

font-weight:600;

}

/* DESCRIPTION */

.class-description{

background:
rgba(255,255,255,0.04);

padding:14px;

border-radius:14px;

font-size:14px;

line-height:1.6;

margin-bottom:14px;

}

/* TOP BUTTONS */

.top-actions{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:10px;

margin-bottom:12px;

}

/* ANALYTICS BUTTON */

.analytics-btn{

background:#ff9800;

color:black;

padding:9px 14px;

border-radius:10px;

text-decoration:none;

font-size:13px;

font-weight:700;

transition:0.3s;

}

.analytics-btn:hover{

background:white;

transform:translateY(-2px);

}

/* ACTION BUTTONS */

.action-buttons{

display:flex;

gap:8px;

flex-wrap:wrap;

align-items:center;

}

/* BUTTONS */

.edit-btn,
.delete-btn,
.members-btn,
.attendance-btn,
.qr-btn,
.open-attendance-btn{

padding:9px 14px;

border-radius:10px;

text-decoration:none;

font-size:13px;

font-weight:700;

transition:0.3s;

border:none;

cursor:pointer;

}

/* COLORS */

.edit-btn{
background:#00cfff;
color:black;
}

.delete-btn{
background:#dc3545;
color:white;
}

.members-btn{
background:#6f42c1;
color:white;
}

.attendance-btn{
background:#198754;
color:white;
}

.qr-btn{
background:#ffcc00;
color:black;
}

.open-attendance-btn{

background:#00d4ff;

color:black;

}

/* HOVER */

.edit-btn:hover,
.delete-btn:hover,
.members-btn:hover,
.attendance-btn:hover,
.qr-btn:hover,
.open-attendance-btn:hover{

background:white;

color:black;

transform:translateY(-2px);

}

/* EMPTY */

.empty-box{

text-align:center;

padding:40px 20px;

opacity:0.8;

}

/* RESPONSIVE */

@media(max-width:992px){

.main-grid{

grid-template-columns:1fr;

}

}

@media(max-width:768px){

.page-title{

font-size:24px;

}

.analytics-card h1{

font-size:22px;

}

.class-title{

font-size:20px;

}

body{

padding:15px;

}

}

</style>

</head>

<body>

<div class="main-container">

<!-- TOP BAR -->

<div class="top-bar">

<h1 class="page-title">
🎵 Music Classes Management
</h1>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

<!-- ANALYTICS -->

<div class="analytics-grid">

<div class="analytics-card total-card">

<h4>
🎵 Total Classes
</h4>

<h1>
<%= totalClasses || 0 %>
</h1>

</div>

<div class="analytics-card trainer-card">

<h4>
👨‍🏫 Trainers
</h4>

<h1>
<%= trainers || 0 %>
</h1>

</div>

<div class="analytics-card schedule-card">

<h4>
📅 Schedules
</h4>

<h1>
<%= schedules || 0 %>
</h1>

</div>

<div class="analytics-card ministry-card">

<h4>
🎶 Active Ministry
</h4>

<h1>
<%= classes.length || 0 %>
</h1>

</div>

</div>

<!-- MAIN GRID -->

<div class="main-grid">

<!-- FORM -->

<div class="form-box">

<h2 class="section-title">
➕ Create Music Class
</h2>

<form
action="/admin/create-music-class"
method="POST"
>

<label class="form-label">
Class Name
</label>

<input
type="text"
name="class_name"
class="form-control"
placeholder="Example: Worship Guitar Basics"
required
>

<label class="form-label">
Trainer / Instructor
</label>

<input
type="text"
name="trainer"
class="form-control"
placeholder="Enter trainer name"
required
>

<label class="form-label">
Category
</label>

<select
name="category"
class="form-select"
required
>

<option value="">
Select Category
</option>

<option>Acoustic Guitar</option>
<option>Electric Guitar</option>
<option>Keyboard & Piano</option>
<option>Drums & Rhythm</option>
<option>Bass Guitar</option>
<option>Worship Vocals</option>
<option>Worship Leading</option>
<option>Multimedia Ministry</option>
<option>Sound System Training</option>

</select>

<label class="form-label">
Schedule
</label>

<input
type="text"
name="schedule"
class="form-control"
placeholder="Example: Saturday 3:00 PM"
required
>

<label class="form-label">
Location
</label>

<input
type="text"
name="location"
class="form-control"
placeholder="Example: Church Main Hall"
required
>

<label class="form-label">
Description
</label>

<textarea
name="description"
class="form-control"
placeholder="Enter class description..."
required
></textarea>

<button
type="submit"
class="create-btn"
>
🎵 Create Music Class
</button>

</form>

</div>

<!-- CLASS LIST -->

<div class="classes-box">

<h2 class="section-title">
📋 Music Class List
</h2>

<% if(classes && classes.length > 0){ %>

<% classes.forEach(item => { %>

<div class="class-card">

<!-- TOP ACTIONS -->

<div class="top-actions">

<a
href="/admin/music-attendance-analytics"
class="analytics-btn"
>
📊 Analytics
</a>

<div class="category-badge">
<%= item.category %>
</div>

</div>

<!-- CLASS TITLE -->

<div class="class-top">

<div class="class-title">
<%= item.class_name %>
</div>

</div>

<!-- INFO -->

<div class="class-info">

<div class="info-card">

<div class="info-title">
👨‍🏫 Trainer
</div>

<div class="info-value">
<%= item.trainer %>
</div>

</div>

<div class="info-card">

<div class="info-title">
📅 Schedule
</div>

<div class="info-value">
<%= item.schedule %>
</div>

</div>

<div class="info-card">

<div class="info-title">
📍 Location
</div>

<div class="info-value">
<%= item.location %>
</div>

</div>

</div>

<!-- DESCRIPTION -->

<div class="class-description">
<%= item.description %>
</div>

<!-- ACTION BUTTONS -->

<div class="action-buttons">

<!-- ATTENDANCE STATUS -->

<% if(item.attendance_open === 'OPEN'){ %>

<div
style="
display:flex;
align-items:center;
gap:10px;
flex-wrap:wrap;
width:100%;
margin-bottom:10px;
"
>

<div
style="
background:#198754;
color:white;
padding:10px 14px;
border-radius:10px;
font-size:13px;
font-weight:700;
"
>

🟢 Attendance Open

</div>

<div
style="
background:rgba(255,255,255,0.08);
padding:10px 14px;
border-radius:10px;
font-size:12px;
color:#ddd;
"
>

⏰ Opened:
<%= item.attendance_start_time
? new Date(item.attendance_start_time).toLocaleString()
: 'N/A'
%>

</div>

<form
action="/admin/close-attendance/<%= item.id %>"
method="POST"
style="display:inline;"
>

<button
type="submit"
class="delete-btn"
>

🔒 Close Attendance

</button>

</form>

</div>

<% } else { %>

<div
style="
display:flex;
align-items:center;
gap:10px;
flex-wrap:wrap;
width:100%;
margin-bottom:10px;
"
>

<div
style="
background:#dc3545;
color:white;
padding:10px 14px;
border-radius:10px;
font-size:13px;
font-weight:700;
"
>

🔴 Attendance Closed

</div>

<form
action="/admin/open-attendance/<%= item.id %>"
method="POST"
style="display:inline;"
>

<button
type="submit"
class="open-attendance-btn"
>

📅 Open Attendance

</button>

</form>

</div>

<% } %>

<!-- EDIT -->

<a
href="/admin/edit-music-class/<%= item.id %>"
class="edit-btn"
>
✏ Edit
</a>

<!-- MEMBERS -->

<a
href="/admin/music-class-members/<%= item.id %>"
class="members-btn"
>
👥 Members
</a>

<!-- ATTENDANCE -->

<a
href="/admin/music-class-attendance/<%= item.id %>"
class="attendance-btn"
>
📋 Attendance
</a>

<!-- DELETE -->

<a
href="/admin/delete-music-class/<%= item.id %>"
class="delete-btn"
onclick="
return confirm(
'Delete this music class?'
)
"
>

🗑 Delete

</a>

</div>

</div>

<% }) %>

<% } else { %>

<div class="empty-box">

<h3>
🎵 No Music Classes Yet
</h3>

<p>
Create your first ministry training class.
</p>

</div>

<% } %>

</div>

</div>

</div>

</body>
</html>