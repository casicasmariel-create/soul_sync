<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Event</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
min-height:100vh;
padding:40px;
color:white;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
transition:0.3s;
}

.back-btn:hover{
background:white;
transform:scale(1.03);
}

.container-box{
max-width:800px;
margin:auto;
background:rgba(255,255,255,0.1);
padding:40px;
border-radius:30px;
backdrop-filter:blur(10px);
box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

.container-box h1{
margin-bottom:30px;
color:#ffcc00;
font-size:35px;
}

input{
width:100%;
height:60px;
border:none;
border-radius:18px;
padding:15px;
margin-bottom:20px;
font-size:16px;
outline:none;
}

textarea{
width:100%;
height:220px;
border:none;
border-radius:18px;
padding:15px;
resize:none;
margin-bottom:20px;
font-size:16px;
outline:none;
}

.save-btn{
background:#00d4ff;
border:none;
padding:14px 25px;
border-radius:15px;
font-weight:bold;
font-size:16px;
transition:0.3s;
}

.save-btn:hover{
background:white;
transform:scale(1.03);
}

</style>

</head>
<body>

<div class="top-bar">

<h1>✏ Edit Event</h1>

<a href="/admin/events" class="back-btn">
← Back Events
</a>

</div>

<div class="container-box">

<form
action="/admin/update-event/<%= event.id %>"
method="POST"
>

<input
type="text"
name="title"
value="<%= event.title %>"
placeholder="Event Title"
required
>

<textarea
name="description"
placeholder="Event Description"
required
><%= event.description %></textarea>

<input
type="text"
name="event_date"
value="<%= event.event_date %>"
placeholder="Event Date"
required
>

<button type="submit" class="save-btn">
💾 Save Changes
</button>

</form>

</div>

</body>
</html>