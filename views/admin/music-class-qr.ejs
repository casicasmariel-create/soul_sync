<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<title>
Music QR Attendance
</title>

<style>

body{

background:#12001f;

color:white;

font-family:Arial;

display:flex;

justify-content:center;

align-items:center;

height:100vh;

flex-direction:column;

}

.qr-box{

background:
rgba(255,255,255,0.08);

padding:40px;

border-radius:30px;

text-align:center;

}

img{

width:300px;

background:white;

padding:20px;

border-radius:20px;

}

h1{

margin-bottom:20px;

}

p{

margin-top:20px;

opacity:0.8;

}

</style>

</head>

<body>

<div class="qr-box">

<h1>
🎵 Music Attendance QR
</h1>

<img src="<%= qrImage %>">

<p>
Scan this QR code to record attendance.
</p>

</div>

</body>
</html>