<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Announcement List</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

color:white;
min-height:100vh;
padding:32px;
}

/* ===================================== */
/* TOP BAR */
/* ===================================== */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:36px;

gap:20px;

flex-wrap:wrap;
}

.left-top{
display:flex;
align-items:center;
gap:14px;
}

.page-title{
font-size:42px;
font-weight:700;
line-height:1.1;
margin:0;
}

.button-group{
display:flex;
gap:12px;
flex-wrap:wrap;
align-items:center;
}

/* ===================================== */
/* BUTTONS */
/* ===================================== */

.back-btn,
.create-btn{

padding:12px 18px;

border-radius:14px;

text-decoration:none;

font-weight:600;

font-size:14px;

transition:0.3s;

display:inline-flex;
align-items:center;
gap:8px;
}

.back-btn{
background:#ffcc00;
color:black;
}

.create-btn{
background:#00d4ff;
color:black;
}

.back-btn:hover,
.create-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

/* ===================================== */
/* GRID */
/* ===================================== */

.announcement-wrapper{

display:grid;

grid-template-columns:
repeat(auto-fit, minmax(320px, 1fr));

gap:24px;
}

/* ===================================== */
/* CARD */
/* ===================================== */

.announcement-card{

background:
rgba(255,255,255,0.10);

padding:24px;

border-radius:24px;

backdrop-filter:blur(10px);

box-shadow:
0 6px 20px rgba(0,0,0,0.15);

transition:0.3s;

display:flex;
flex-direction:column;
}

.announcement-card:hover{
transform:translateY(-3px);
}

/* ===================================== */
/* TITLE */
/* ===================================== */

.announcement-title{

color:#ffcc00;

font-size:28px;

font-weight:700;

line-height:1.3;

margin-bottom:14px;

word-break:break-word;
}

/* ===================================== */
/* CONTENT */
/* ===================================== */

.announcement-content{

white-space:pre-line;

line-height:1.7;

font-size:15px;

color:#f1f1f1;

margin-bottom:18px;

opacity:0.95;
}

/* ===================================== */
/* DATE */
/* ===================================== */

.announcement-date{
font-size:13px;
opacity:0.75;
margin-bottom:20px;
}

/* ===================================== */
/* ACTION BUTTONS */
/* ===================================== */

.action-buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:auto;
}

/* ===================================== */
/* EDIT BUTTON */
/* ===================================== */

.edit-btn{

background:#00d4ff;

color:black;

text-decoration:none;

padding:10px 16px;

border-radius:12px;

font-weight:600;

font-size:14px;

transition:0.3s;
}

.edit-btn:hover{
background:white;
color:black;
transform:translateY(-2px);
}

/* ===================================== */
/* DELETE BUTTON */
/* ===================================== */

.delete-btn{

background:#ff3b3b;

color:white;

text-decoration:none;

padding:10px 16px;

border-radius:12px;

font-weight:600;

font-size:14px;

transition:0.3s;
}

.delete-btn:hover{
background:#ff6666;
transform:translateY(-2px);
}

/* ===================================== */
/* MOBILE */
/* ===================================== */

@media(max-width:768px){

body{
padding:20px;
}

.page-title{
font-size:34px;
}

.top-bar{
align-items:flex-start;
}

.button-group{
width:100%;
}

.back-btn,
.create-btn{
width:100%;
justify-content:center;
}

.announcement-title{
font-size:24px;
}

}

</style>

</head>
<body>

<!-- ===================================== -->
<!-- TOP BAR -->
<!-- ===================================== -->

<div class="top-bar">

<div class="left-top">

<h1 class="page-title">
📋 Announcement List
</h1>

</div>

<div class="button-group">

<a
href="/admin/announcements"
class="create-btn"
>
➕ Create Announcement
</a>

<a
href="/dashboard"
class="back-btn"
>
← Dashboard
</a>

</div>

</div>

<!-- ===================================== -->
<!-- ANNOUNCEMENTS -->
<!-- ===================================== -->

<div class="announcement-wrapper">

<% announcements.forEach(announcement => { %>

<div class="announcement-card">

<!-- TITLE -->

<h2 class="announcement-title">
<%= announcement.title %>
</h2>

<!-- CONTENT -->

<div class="announcement-content">
<%= announcement.content %>
</div>

<!-- DATE -->

<div class="announcement-date">

🕒

<%= new Date(
new Date(announcement.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</div>

<!-- ACTION BUTTONS -->

<div class="action-buttons">

<a
href="/admin/edit-announcement/<%= announcement.id %>"
class="edit-btn"
>
✏ Edit
</a>

<a
href="/admin/delete-announcement/<%= announcement.id %>"
class="delete-btn"
onclick="return confirm('Delete this announcement?')"
>
🗑 Delete
</a>

</div>

</div>

<% }) %>

</div>

</body>
</html>