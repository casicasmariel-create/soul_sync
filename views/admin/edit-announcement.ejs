<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Announcement</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
font-family:Arial;
padding:40px;
min-height:100vh;
}

.box{
background:rgba(255,255,255,0.1);
padding:35px;
border-radius:30px;
backdrop-filter:blur(10px);
}

input{
width:100%;
height:60px;
border:none;
border-radius:18px;
padding:15px;
margin-bottom:20px;
}

textarea{
width:100%;
height:220px;
border:none;
border-radius:18px;
padding:15px;
resize:none;
margin-bottom:20px;
}

button{
background:#00d4ff;
border:none;
padding:14px 22px;
border-radius:15px;
font-weight:bold;
}

a{
color:#ffcc00;
text-decoration:none;
}

</style>

</head>
<body>

<a href="/admin/announcements">
← Back Announcements
</a>

<br><br>

<div class="box">

<h1>✏ Edit Announcement</h1>

<br>

<form
action="/admin/update-announcement/<%= announcement.id %>"
method="POST"
>

<input
type="text"
name="title"
value="<%= announcement.title %>"
required
>

<textarea
name="content"
required
><%= announcement.content %></textarea>

<button type="submit">
Save Changes
</button>

</form>

</div>

</body>
</html>