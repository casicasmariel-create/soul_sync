<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create Event</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
font-family:Arial;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:35px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
}

.main-box{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
backdrop-filter:blur(10px);
max-width:700px;
margin:auto;
}

input, textarea{
width:100%;
border:none;
border-radius:15px;
padding:15px;
margin-bottom:18px;
}

textarea{
height:180px;
resize:none;
}

.button-group{
display:flex;
gap:12px;
flex-wrap:wrap;
}

.create-btn{
background:#ffcc00;
color:black;
border:none;
padding:12px 22px;
border-radius:14px;
font-weight:bold;
}

.view-btn{
background:#00d4ff;
color:black;
text-decoration:none;
padding:12px 22px;
border-radius:14px;
font-weight:bold;
display:flex;
align-items:center;
}

</style>

</head>
<body>

<div class="top-bar">

<h1>📅 Create Event</h1>

<a href="/dashboard" class="back-btn">
← Dashboard
</a>

</div>

<div class="main-box">

<form action="/admin/create-event" method="POST">

<input
type="text"
name="title"
placeholder="Event Title"
required
>

<textarea
name="description"
placeholder="Event Description"
required
></textarea>

<input
type="text"
name="event_date"
placeholder="Event Date"
required
>

<div class="button-group">

<button type="submit" class="create-btn">
📅 Create Event
</button>

<a href="/admin/event-list" class="view-btn">
📋 View Events
</a>

</div>

</form>

</div>

</body>
</html>