<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>
Music Class Members
</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{

background:
linear-gradient(
135deg,
#12001f,
#2c003e,
#4b006e
);

min-height:100vh;

padding:30px;

color:white;

}

/* TOP */

.top-bar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

margin-bottom:30px;

}

.page-title{

font-size:38px;
font-weight:700;

}

.back-btn{

background:#ffcc00;
color:black;

padding:12px 20px;

border-radius:14px;

text-decoration:none;

font-weight:700;

transition:0.3s;

}

.back-btn:hover{

background:white;

transform:translateY(-2px);

}

/* HEADER */

.header-box{

background:
rgba(255,255,255,0.08);

padding:28px;

border-radius:28px;

margin-bottom:30px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

}

.header-title{

font-size:30px;
font-weight:700;

margin-bottom:10px;

color:#ffcc00;

}

.header-sub{

line-height:1.8;

opacity:0.9;

}

/* TABLE */

.table-wrapper{

background:
rgba(255,255,255,0.08);

padding:25px;

border-radius:28px;

backdrop-filter:blur(10px);

box-shadow:
0 8px 20px rgba(0,0,0,0.15);

overflow-x:auto;

}

table{

width:100%;

border-collapse:collapse;

}

th{

background:
rgba(255,255,255,0.12);

padding:18px;

font-size:14px;

color:#ffcc00;

text-align:left;

}

td{

padding:18px;

border-bottom:
1px solid rgba(255,255,255,0.08);

font-size:15px;

}

tr:hover{

background:
rgba(255,255,255,0.04);

}

/* EMPTY */

.empty-box{

text-align:center;

padding:70px 20px;

opacity:0.8;

}

/* RESPONSIVE */

@media(max-width:768px){

body{
padding:18px;
}

.page-title{
font-size:30px;
}

.header-title{
font-size:24px;
}

}

</style>

</head>

<body>

<!-- TOP -->

<div class="top-bar">

<h1 class="page-title">
🎵 Music Class Members
</h1>

<a
href="/admin/music-classes"
class="back-btn"
>
← Back
</a>

</div>

<!-- HEADER -->

<div class="header-box">

<div class="header-title">
👥 Worship Trainees & Participants
</div>

<div class="header-sub">

Monitor and manage all users who joined ministry music training classes and worship development programs.

</div>

</div>

<!-- TABLE -->

<div class="table-wrapper">

<% if(members.length > 0){ %>

<table>

<thead>

<tr>

<th>
# 
</th>

<th>
👤 Full Name
</th>

<th>
📧 Email
</th>

<th>
📅 Joined Date
</th>

</tr>

</thead>

<tbody>

<% members.forEach((member, index) => { %>

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<%= member.fullname %>
</td>

<td>
<%= member.email %>
</td>

<td>

<%= new Date(member.created_at)
.toLocaleDateString() %>

</td>

</tr>

<% }) %>

</tbody>

</table>

<% } else { %>

<div class="empty-box">

<h2>
🎵 No Members Yet
</h2>

<p style="margin-top:10px;">

No users have joined this music class yet.

</p>

</div>

<% } %>

</div>

</body>
</html>