<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Event Responses</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
background:linear-gradient(135deg,#12001f,#2c003e,#4b006e);
color:white;
min-height:100vh;
padding:40px;
font-family:Arial;
}

.top-bar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.back-btn{
background:#ffcc00;
color:black;
padding:12px 20px;
border-radius:15px;
text-decoration:none;
font-weight:bold;
}

.response-box{
background:rgba(255,255,255,0.1);
padding:30px;
border-radius:25px;
backdrop-filter:blur(10px);
}

.event-title{
font-size:45px;
color:#ffcc00;
margin-bottom:15px;
}

.table{
margin-top:25px;
border-radius:18px;
overflow:hidden;
}

.table th{
background:#2c003e !important;
color:#ffcc00 !important;
text-align:center;
}

.table td{
text-align:center;
vertical-align:middle;
}

</style>

</head>
<body>

<div class="top-bar">

<h1>
📋 Event Responses
</h1>

<a href="/admin/event-list" class="back-btn">
← Back
</a>

</div>

<div class="response-box">

<h2 class="event-title">
<%= event.title %>
</h2>

<p>
<%= event.description %>
</p>

<table class="table table-dark table-bordered">

<thead>

<tr>

<th>#</th>
<th>Full Name</th>
<th>Status</th>
<th>Date Responded</th>

</tr>

</thead>

<tbody>

<% responses.forEach((response, index) => { %>

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<%= response.fullname %>
</td>

<td>

<% if(response.response_status === 'JOINING'){ %>

<span class="badge bg-info text-dark">
✅ JOINING
</span>

<% } else { %>

<span class="badge bg-danger">
❌ NOT JOINING
</span>

<% } %>

</td>

<td>

<%= new Date(
new Date(response.created_at).getTime()
+ (8 * 60 * 60 * 1000)
).toLocaleString('en-PH', {

year:'numeric',
month:'long',
day:'numeric',

hour:'numeric',
minute:'2-digit',

hour12:true

}) %>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</body>
</html>